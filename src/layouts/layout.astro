---
import '../styles/global.css';
import Header from '../components/header.astro';
import Footer from '../components/footer.astro';
import { members } from '@wix/members';
import { currentLanguage } from '../utils/i18n';

const googleFontsHref =
  'https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400..700&family=Inter:wght@400;500;600&display=swap';

interface Props {
  noindex?: boolean;
  header?: boolean;
}

const { noindex = false, header = true } = Astro.props;

let loggedIn = false;
try {
  const { member } = await members.getCurrentMember();
  loggedIn = Boolean(member);
} catch {
  loggedIn = false;
}

const lang = currentLanguage();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <slot name="seo-tags" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#08090a" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={googleFontsHref} />

    <slot name="head" />
  </head>
  <body class="min-h-svh overflow-x-clip">
    {header && <Header loggedIn={loggedIn} />}
    <main id="contenido" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <Footer />
  </body>
</html>
