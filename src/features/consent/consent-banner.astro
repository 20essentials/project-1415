---
import { useTranslation } from '@/shared/i18n';

const { t } = useTranslation();
---

<aside
  data-pp-consent
  hidden
  role="region"
  aria-labelledby="pp-consent-title"
  class="pp-consent"
>
  <div class="pp-consent__panel">
    <div class="pp-consent__copy">
      <h2 id="pp-consent-title" class="font-display text-lg text-ink">{t('consent.title')}</h2>
      <p class="mt-1 text-sm leading-6 text-ink-soft">{t('consent.text')}</p>
    </div>
    <div class="pp-consent__actions">
      <button type="button" data-consent-reject class="pp-consent__button pp-consent__button--reject">
        {t('consent.reject')}
      </button>
      <button type="button" data-consent-accept class="pp-consent__button pp-consent__button--accept">
        {t('consent.accept')}
      </button>
    </div>
  </div>
</aside>

<script>
  import { getConsentState, setConsentState, type ConsentState } from '@/shared/consent';

  const banner = document.querySelector<HTMLElement>('[data-pp-consent]');

  if (banner && !getConsentState()) {
    banner.hidden = false;
    requestAnimationFrame(() => banner.setAttribute('data-open', ''));

    const decide = (state: ConsentState) => () => {
      setConsentState(state);
      banner.removeAttribute('data-open');
      banner.hidden = true;
    };

    banner
      .querySelector('[data-consent-accept]')
      ?.addEventListener('click', decide('accepted'));
    banner
      .querySelector('[data-consent-reject]')
      ?.addEventListener('click', decide('rejected'));
  }
</script>

<style>
  .pp-consent {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 60;
    padding: 1rem;
    opacity: 0;
    transform: translateY(1rem);
    transition:
      opacity 200ms var(--ease-fluid),
      transform 200ms var(--ease-fluid);
  }

  .pp-consent[data-open] {
    opacity: 1;
    transform: none;
  }

  .pp-consent__panel {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 42rem;
    margin-inline: auto;
    padding: 1.25rem;
    border: 1px solid var(--color-rule);
    border-radius: 12px;
    background-color: var(--color-paper-warm);
  }

  .pp-consent__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .pp-consent__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding: 0.5rem 1.25rem;
    border-radius: 9999px;
    font-size: var(--text-sm);
    font-weight: 500;
    transition:
      background-color 200ms var(--ease-fluid),
      color 200ms var(--ease-fluid);
  }

  .pp-consent__button--accept {
    background-color: var(--color-accent);
    color: var(--color-paper);
  }

  .pp-consent__button--accept:hover {
    background-color: var(--color-cream);
  }

  .pp-consent__button--reject {
    color: var(--color-ink);
    box-shadow: inset 0 0 0 1px var(--color-rule);
  }

  .pp-consent__button--reject:hover {
    background-color: color-mix(in oklab, var(--color-ink) 10%, transparent);
  }

  @media (min-width: 640px) {
    .pp-consent__panel {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      padding: 1.5rem;
    }

    .pp-consent__actions {
      flex-shrink: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pp-consent {
      transform: none;
      transition: opacity 200ms var(--ease-fluid);
    }
  }
</style>
