---
import { site } from '@/shared/site';
import { useTranslation, localize } from '@/shared/i18n';

const { t } = useTranslation();

const stops = site.paseo.stops.map((stop) => {
  const claims = 'claims' in stop ? stop.claims.map((claim) => t(claim)) : undefined;
  const steps = 'steps' in stop ? stop.steps.map((step) => t(step)) : undefined;
  const cta = 'cta' in stop ? { href: localize(stop.cta.href), label: t(stop.cta.label) } : undefined;
  return {
    ...stop,
    label: t(stop.label),
    eyebrow: t(stop.eyebrow),
    title: t(stop.title),
    subtitle: stop.subtitle ? t(stop.subtitle) : '',
    claims,
    steps,
    cta,
  };
});

const world = {
  nav: false,
  atmosphere: false,
  hint: t('paseo.hint'),
  crossfade: 0.07,
  diveScroll: 0.9,
  connScroll: 1.0,
  connectors: [
    '/videos/v1.mp4',
    '/videos/v2.mp4',
    '/videos/v3.mp4',
    '/videos/v4.mp4',
    '/videos/v5.mp4',
    null
  ],
  connectorsMobile: [
    '/videos-mobile/v1.mp4',
    '/videos-mobile/v2.mp4',
    '/videos-mobile/v3.mp4',
    '/videos-mobile/v4.mp4',
    '/videos-mobile/v5.mp4',
    null
  ],
  sections: stops.map((stop, i) => ({
    id: stop.id,
    label: stop.label,
    still: stop.poster,
    focusX: stop.focus,
    titleTag: i === 0 ? 'h1' : 'h2',
    eyebrow: stop.eyebrow,
    title: stop.title,
    body: stop.subtitle,
    tags: stop.steps ?? stop.claims ?? [],
    cta: stop.cta ? { primary: stop.cta } : undefined,
    scroll: 'scroll' in stop ? stop.scroll : undefined,
    linger: 'linger' in stop ? stop.linger : undefined,
    accent: 'var(--color-accent)'
  }))
};
---

<div data-world class='sw-wrap'></div>

<script
  id='world-config'
  type='application/json'
  set:html={JSON.stringify(world).replace(/</g, '\\u003c')}
/>

<script is:inline>
  // Reserve the scrub height before first paint: the engine sets the track
  // height only after hydration, which would otherwise push every section
  // below the fold (the biggest CLS on the site). Keep in sync with the
  // segment math in scroll-world.js (dive + connector widths + 1vh tail).
  (function () {
    var wrap = document.querySelector('[data-world]');
    var cfg = document.getElementById('world-config');
    if (!wrap || !cfg) return;
    try {
      var c = JSON.parse(cfg.textContent || '{}');
      var secs = c.sections || [];
      var cons = c.connectors || [];
      var dive = c.diveScroll || 1.3;
      var conn = c.connScroll || 0.9;
      var w = 0;
      for (var i = 0; i < secs.length; i++) {
        w += secs[i].scroll || dive;
        if (i < secs.length - 1 && cons[i]) w += conn;
      }
      wrap.style.minHeight = (w + 1) * window.innerHeight + 'px';
    } catch (e) {}
  })();
</script>

<script>
  import { mountScrollWorld } from './scroll-world.js';

  type SwWindow = Window & { __swGoTo?: (id: string) => boolean };

  function boot() {
    const config = document.getElementById('world-config');
    if (!config) return;
    const parsed = JSON.parse(config.textContent || '{}');
    document.querySelectorAll<HTMLElement>('[data-world]').forEach(el => {
      if (el.dataset.mounted) return;
      el.dataset.mounted = 'true';
      mountScrollWorld(el, parsed);
      const dots = el.querySelectorAll<HTMLButtonElement>('.sw-route__dot');
      (window as SwWindow).__swGoTo = (id: string) => {
        const index = (parsed.sections || []).findIndex(
          (section: { id: string }) => section.id === id
        );
        if (index < 0 || !dots[index]) return false;
        dots[index].click();
        return true;
      };
      // Links like /#care arrive from other pages; land on the matching stop.
      (window as SwWindow).__swGoTo?.(decodeURIComponent(window.location.hash.slice(1)));
    });
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>

<style is:global>
  .sw-wrap {
    position: relative;
    z-index: 1;
  }

  /* Engine tokens → brand design system. Unlayered, so these win over the
     engine defaults injected inside @layer sw. :root also covers the engine's
     html/body background rule. */
  :root,
  .sw-root {
    --sw-bg: var(--color-paper);
    --sw-ink: var(--color-ink);
    --sw-ink-soft: var(--color-ink-soft);
    --sw-accent: var(--color-accent);
    --sw-font-display: var(--font-display);
    --sw-font-body: var(--font-body);
  }

  .sw-topbar:empty {
    display: none;
  }

  .sw-particles {
    display: none;
  }

  .sw-root .sw-btn--primary {
    color: var(--sw-bg);
    background: var(--sw-accent);
  }

  /* The engine confines its fixed chrome to the .sw-wrap stacking context, so
     the content after the hero and the footer must sit above it. */
  .sw-wrap ~ *,
  footer {
    position: relative;
    z-index: 2;
  }
</style>
