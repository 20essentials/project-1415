---
import { useTranslation, localize } from '@/shared/i18n';
import { GlitchText } from './glitch-text.tsx';

const { t } = useTranslation();

const shortcuts = [
  { href: '/products', label: 'nav.all-plants' },
  { href: '/journal', label: 'nav.journal' },
  { href: '/services', label: 'nav.services' },
  { href: '/events', label: 'nav.events' },
  { href: '/blog', label: 'nav.blog' },
];
---

<section
  class="relative isolate flex min-h-svh items-center overflow-hidden bg-paper px-4 py-24 text-ink sm:px-8 lg:px-20 lg:py-32"
>
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden">
    <div
      class="absolute top-1/2 left-1/2 size-96 -translate-x-1/2 -translate-y-1/2 rounded-full bg-accent/10 blur-3xl sm:size-128"
    >
    </div>
    <div
      class="absolute top-1/3 left-1/3 size-64 -translate-x-1/2 -translate-y-1/2 rounded-full bg-cream/5 blur-3xl sm:size-80"
    >
    </div>
  </div>

  <div class="relative mx-auto flex w-full max-w-3xl flex-col items-center text-center">
    <div aria-hidden="true">
      <GlitchText
        client:load
        className="font-display text-ink"
        mode="slices"
        speed={0.6}
        intensity={0.7}
        offset={16}
        shadowColors={['#18e299', '#faf8f5']}
        fontSize="clamp(6rem, 26vw, 12rem)"
        fontWeight={400}
      >
        404
      </GlitchText>
    </div>

    <span aria-hidden="true" class="mt-6 h-px w-16 bg-accent/60"></span>

    <p class="mt-6 text-xs font-medium tracking-widest text-accent uppercase">
      {t('not-found.eyebrow')}
    </p>
    <h1 class="mt-3 font-display text-4xl leading-tight text-ink text-balance lg:text-5xl">
      {t('not-found.title')}
    </h1>
    <p class="mt-4 max-w-xl text-sm leading-6 text-ink-soft">
      {t('not-found.body')}
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a href={localize('/products')} class="btn btn-primary">
        <span class="text-trim">{t('not-found.cta-shop')}</span>
      </a>
      <a href={localize('/')} class="btn btn-ghost">
        <span class="text-trim">{t('not-found.cta-home')}</span>
      </a>
    </div>

    <nav class="mt-16 w-full border-t border-rule pt-8" aria-label={t('not-found.hint')}>
      <p class="text-xs font-medium tracking-widest text-mute uppercase">{t('not-found.hint')}</p>
      <ul class="mt-4 flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-sm">
        {
          shortcuts.map((shortcut) => (
            <li>
              <a href={localize(shortcut.href)} class="link text-ink-soft">
                {t(shortcut.label)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</section>
