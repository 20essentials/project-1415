---
import { resolveWixImageUrl } from '@/shared/wix-image';
import { WishlistHeart } from '@/features/wishlist/wishlist-heart';
import { useTranslation, localize, stripLocalePrefix } from '@/shared/i18n';

interface Props {
  product: {
    _id?: string | null;
    name?: string | null;
    slug?: string | null;
    media?: { main?: { image?: string | null; url?: string | null; altText?: string | null } | null } | null;
    actualPriceRange?: { minValue?: { formattedAmount?: string | null } | null } | null;
  };
  index?: number;
  // Ancho del slot que ocupa la tarjeta en su grilla; la página que compone
  // la pasa para que el navegador elija 400w/640w sin adivinar columnas.
  sizes?: string;
  isMember?: boolean;
  wished?: boolean;
}

const { product, index, isMember = false, wished = false, sizes = '(min-width: 1280px) 280px, (min-width: 1024px) 360px, (min-width: 640px) 46vw, 92vw' } =
  Astro.props;
const { t } = useTranslation();

const wishlistLabels = {
  add: t('wishlist.add'),
  remove: t('wishlist.remove'),
  signIn: t('wishlist.sign-in'),
  error: t('wishlist.error'),
};
const signInHref = localize(
  `/api/auth/login?returnToUrl=${localize(stripLocalePrefix(Astro.url.pathname))}`,
);

const imageRef = product.media?.main?.image ?? product.media?.main?.url;
const imageUrl = resolveWixImageUrl(imageRef, 640, 800);
// Grillas 1–4 columnas según viewport; 400w cubre el móvil sin bajar de ~1.6x DPR.
const imageSrcSet = [400, 640]
  .map((w) => resolveWixImageUrl(imageRef, w, Math.round(w * 1.25)))
  .filter((url): url is string => Boolean(url))
  .join(', ');
const imageAlt = product.media?.main?.altText ?? product.name ?? t('product.photo-alt');
const price = product.actualPriceRange?.minValue?.formattedAmount;
const indexLabel =
  typeof index === 'number' ? String(index + 1).padStart(2, '0') : null;
---

<li class="relative" data-product-card data-product-id={product._id ?? ''} data-product-slug={product.slug ?? ''} data-product-name={product.name ?? ''} data-product-price={price ?? ''}>
  <a href={localize(`/products/${product.slug}`)} class="group block" data-product-link>
    <div
      class="relative aspect-4/5 overflow-hidden rounded-lg bg-paper-warm ring-1 ring-rule"
      transition:name={product.slug ? `product-${product.slug}` : undefined}
    >
      {
        imageUrl ? (
          <img
            src={imageUrl}
            srcset={imageSrcSet || undefined}
            sizes={sizes}
            alt={imageAlt}
            width="640"
            height="800"
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover transition-transform duration-700 ease-fluid group-hover:scale-105 motion-reduce:transform-none"
          />
        ) : (
          <span class="flex h-full w-full items-center justify-center px-4 text-center text-xs text-mute">
            {t('home.photo-coming')}
          </span>
        )
      }
      {
        indexLabel && (
          <span class="absolute top-3 left-3 rounded-full bg-paper/80 px-2.5 py-1 text-xs font-medium text-ink-soft backdrop-blur">
            N°&nbsp;{indexLabel}
          </span>
        )
      }
    </div>
    <h3 class="mt-4 font-display text-base text-ink lg:text-lg">{product.name}</h3>
    {price && <p class="mt-1 text-sm font-medium text-ink-soft">{price}</p>}
  </a>
  {
    product._id && (
      <div class="absolute top-3 right-3">
        <WishlistHeart
          client:idle
          productId={product._id}
          productSlug={product.slug ?? undefined}
          initialWished={wished}
          isMember={isMember}
          signInHref={signInHref}
          labels={wishlistLabels}
        />
      </div>
    )
  }
</li>
