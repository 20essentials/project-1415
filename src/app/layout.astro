---
import '../styles/global.css';
import Header from './header.astro';
import Footer from './footer.astro';
import ConsentBanner from '@/features/consent/consent-banner.astro';
import ConsentBootstrap from '@/features/consent/consent-bootstrap.astro';
import { members } from '@wix/members';
import { currentLanguage } from '@/shared/i18n';
import { ClientRouter } from 'astro:transitions';

interface Props {
  noindex?: boolean;
  header?: boolean;
}

const { noindex = false, header = true } = Astro.props;

let loggedIn = false;
try {
  const { member } = await members.getCurrentMember();
  loggedIn = Boolean(member);
} catch {
  loggedIn = false;
}

const lang = currentLanguage();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <slot name="seo-tags" />
    <ClientRouter />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <ConsentBootstrap />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#08090a" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="mask-icon" href="/mask-icon.svg" color="#0fb681" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="preload" href="/fonts/fraunces-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />

    <slot name="head" />
  </head>
  <body class="min-h-svh overflow-x-clip">
    {header && <Header loggedIn={loggedIn} />}
    <main id="contenido" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <Footer />
    <ConsentBanner />
  </body>
</html>
