---
import Logo from './logo.astro';
import { NewsletterForm } from '@/features/newsletter/newsletter-form';
import { site } from '@/shared/site';
import { useTranslation, localize } from '@/shared/i18n';
import { getFormIdByName, NEWSLETTER_FORM_NAME } from '@/shared/wix-forms';

const year = new Date().getFullYear();
const { links } = site;
const { t } = useTranslation();

const newsletterFormId = await getFormIdByName(NEWSLETTER_FORM_NAME);

const newsletterLabels = {
  label: t('footer.newsletter.label'),
  placeholder: t('footer.newsletter.placeholder'),
  submit: t('footer.newsletter.submit'),
  sending: t('footer.newsletter.sending'),
  success: t('footer.newsletter.success'),
  error: t('footer.newsletter.error'),
  invalid: t('footer.newsletter.invalid')
};

const columns = [
  {
    title: 'footer.shop',
    items: [
      { href: links.shop, label: 'nav.all-plants' },
      { href: '/category/carnivorous', label: 'footer.carnivorous' },
      { href: '/category/flowers', label: 'footer.flowers' },
      { href: '/category/kits-accessories', label: 'footer.kits' }
    ]
  },
  {
    title: 'footer.company',
    items: [
      { href: '/about', label: 'nav.about' },
      { href: '/contact', label: 'nav.contact' }
    ]
  },
  {
    title: 'footer.care',
    items: [
      { href: '/contact#shipping', label: 'footer.shipping' },
      { href: '/contact#care', label: 'footer.plant-care' }
    ]
  }
];
---

<footer class='relative bg-paper px-4 pt-24 pb-12 text-ink sm:px-8 lg:px-20'>
  <div class='mx-auto grid max-w-6xl gap-12 md:grid-cols-2 lg:grid-cols-5'>
    <div class='flex flex-col gap-4 lg:col-span-2'>
      <Logo class='text-base' />
      <p class='max-w-xs text-sm leading-6 text-ink-soft'>
        {t('footer.about')}
      </p>
      <a
        href={localize(links.shop)}
        class='mt-2 inline-flex h-10 w-fit items-center justify-center rounded-full bg-accent px-5 text-sm font-medium text-paper transition-colors duration-700 ease-fluid hover:bg-cream'
      >
        <span class='text-trim'>{t('common.shop-the-collection')}</span>
      </a>
    </div>

    {
      columns.map(column => (
        <div class='flex flex-col gap-3 text-sm'>
          <h2 class='text-xs font-medium tracking-widest text-mute uppercase'>
            {t(column.title)}
          </h2>
          <ul class='flex flex-col gap-2'>
            {column.items.map(item => (
              <li>
                <a
                  href={localize(item.href)}
                  class='link text-ink-soft hover:text-ink'
                >
                  {t(item.label)}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <div class='mx-auto mt-16 max-w-6xl border-t border-rule pt-10'>
    <div class='grid gap-6 lg:grid-cols-2 lg:gap-16'>
      <div>
        <p class='text-xs font-medium tracking-widest text-accent uppercase'>
          {t('footer.newsletter.eyebrow')}
        </p>
        <h2 class='mt-3 font-display text-2xl leading-tight text-ink lg:text-3xl'>
          {t('footer.newsletter.title')}
        </h2>
        <p class='mt-2 max-w-md text-sm leading-6 text-ink-soft'>
          {t('footer.newsletter.body')}
        </p>
      </div>
      <div class='lg:pt-2'>
        {
          newsletterFormId ? (
            <NewsletterForm
              client:idle
              formId={newsletterFormId}
              labels={newsletterLabels}
            />
          ) : (
            <p class='text-sm leading-6 text-ink-soft'>
              {t('footer.newsletter.empty')}{' '}
              <a
                href='mailto:hello@petalsandpredators.com'
                class='link text-accent'
              >
                hello@petalsandpredators.com
              </a>
              .
            </p>
          )
        }
      </div>
    </div>
  </div>

  <div
    class='mx-auto mt-16 flex max-w-6xl flex-col gap-3 border-t border-rule pt-8 text-xs text-mute sm:flex-row sm:items-center sm:justify-between'
  >
    <div class='flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-4'>
      <p>{t('footer.rights', { year })}</p>
      <button
        type='button'
        data-pp-open-preferences
        class='w-fit text-left text-xs text-mute underline-offset-4 hover:text-ink hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent'
      >
        Cookie preferences
      </button>
    </div>
    <p>{t('footer.tagline')}</p>
  </div>
</footer>

<div
  id='pp-preferences-modal'
  class='pp-prefs'
  role='dialog'
  aria-modal='true'
  aria-labelledby='pp-prefs-title'
  hidden
>
  <div class='pp-prefs__backdrop' data-pp-prefs-close></div>
  <div class='pp-prefs__panel' role='document'>
    <div class='pp-prefs__header'>
      <h2 id='pp-prefs-title' class='font-display text-lg text-ink'>
        Cookie preferences
      </h2>
      <button
        type='button'
        class='pp-prefs__close'
        aria-label='Close'
        data-pp-prefs-close
      >
        ×
      </button>
    </div>
    <div class='pp-prefs__body'>
      <p class='text-sm leading-6 text-ink-soft'>
        Manage your consent preferences. Essential cookies are always enabled.
      </p>
      <div class='pp-prefs__groups'>
        <label class='pp-prefs__row'>
          <div>
            <div class='pp-prefs__label'>Essential</div>
            <div class='pp-prefs__desc'>Required for the site to function.</div>
          </div>
          <input type='checkbox' checked disabled />
        </label>
        <label class='pp-prefs__row'>
          <div>
            <div class='pp-prefs__label'>Functional / Preferences</div>
            <div class='pp-prefs__desc'>
              Remember choices and improve experience.
            </div>
          </div>
          <input type='checkbox' data-pp-pref='functional' />
        </label>
        <label class='pp-prefs__row'>
          <div>
            <div class='pp-prefs__label'>Analytics</div>
            <div class='pp-prefs__desc'>Help us understand usage.</div>
          </div>
          <input type='checkbox' data-pp-pref='analytics' />
        </label>
        <label class='pp-prefs__row'>
          <div>
            <div class='pp-prefs__label'>Marketing / Advertising</div>
            <div class='pp-prefs__desc'>Personalized content and ads.</div>
          </div>
          <input type='checkbox' data-pp-pref='marketing' />
        </label>
      </div>
    </div>
    <div class='pp-prefs__footer'>
      <button
        type='button'
        class='pp-prefs__btn pp-prefs__btn--ghost'
        data-pp-prefs-reject>Reject all</button
      >
      <button
        type='button'
        class='pp-prefs__btn pp-prefs__btn--primary'
        data-pp-prefs-save>Save preferences</button
      >
    </div>
  </div>
</div>

<script>
  import {
    getGranularConsentPreferences,
    saveGranularConsentPreferences,
    revokeAllConsent
  } from '@/shared/consent';

  const openBtn = document.querySelector('[data-pp-open-preferences]');
  const modal = document.getElementById('pp-preferences-modal');
  if (openBtn && modal) {
    const closeEls = modal.querySelectorAll('[data-pp-prefs-close]');
    const saveBtn = modal.querySelector('[data-pp-prefs-save]');
    const rejectBtn = modal.querySelector('[data-pp-prefs-reject]');
    const prefInputs = Array.from(
      modal.querySelectorAll<HTMLInputElement>('input[data-pp-pref]')
    );

    const open = () => {
      const prefs = getGranularConsentPreferences();
      prefInputs.forEach(input => {
        const key = input.getAttribute('data-pp-pref');
        if (key === 'functional')
          input.checked = !!(prefs.functional || prefs.preferences);
        if (key === 'analytics') input.checked = !!prefs.analytics;
        if (key === 'marketing')
          input.checked = !!(prefs.marketing || prefs.advertising);
      });
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
      const focusable = modal.querySelector<HTMLElement>(
        'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
      );
      focusable?.focus();
    };
    const close = () => {
      modal.hidden = true;
      document.body.style.overflow = '';
    };

    openBtn.addEventListener('click', open);
    closeEls.forEach(el => el.addEventListener('click', close));
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape' && !modal.hidden) close();
    });

    saveBtn?.addEventListener('click', () => {
      const functional = !!modal.querySelector<HTMLInputElement>(
        'input[data-pp-pref="functional"]'
      )?.checked;
      const analytics = !!modal.querySelector<HTMLInputElement>(
        'input[data-pp-pref="analytics"]'
      )?.checked;
      const marketing = !!modal.querySelector<HTMLInputElement>(
        'input[data-pp-pref="marketing"]'
      )?.checked;
      saveGranularConsentPreferences({
        functional,
        preferences: functional,
        analytics,
        marketing,
        advertising: marketing,
        dataToThirdParty: marketing
      });
      close();
    });

    rejectBtn?.addEventListener('click', () => {
      revokeAllConsent();
      close();
    });
  }
</script>

<style>
  .pp-prefs {
    position: fixed;
    inset: 0;
    z-index: 70;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }
  .pp-prefs[hidden] {
    display: none;
  }
  .pp-prefs__backdrop {
    position: absolute;
    inset: 0;
    background: color-mix(in oklab, var(--color-ink) 40%, transparent);
  }
  .pp-prefs__panel {
    position: relative;
    width: 100%;
    max-width: 32rem;
    max-height: calc(100dvh - 2rem);
    overflow: auto;
    border: 1px solid var(--color-rule);
    border-radius: 12px;
    background: var(--color-paper);
    display: flex;
    flex-direction: column;
    box-shadow: 0 20px 60px color-mix(in oklab, var(--color-ink) 20%, transparent);
  }
  .pp-prefs__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--color-rule);
  }
  .pp-prefs__close {
    font-size: 1.25rem;
    line-height: 1;
    color: var(--color-mute);
  }
  .pp-prefs__body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1rem 1.25rem;
  }
  .pp-prefs__groups {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .pp-prefs__row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem;
    border: 1px solid var(--color-rule);
    border-radius: 8px;
    background: var(--color-paper-warm);
  }
  .pp-prefs__label {
    font-size: 0.875rem;
    color: var(--color-ink);
  }
  .pp-prefs__desc {
    margin-top: 0.25rem;
    font-size: 0.75rem;
    color: var(--color-ink-soft);
  }
  .pp-prefs__footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: flex-end;
    padding: 0.75rem 1.25rem 1rem;
    border-top: 1px solid var(--color-rule);
  }
  .pp-prefs__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    font-size: var(--text-sm);
  }
  .pp-prefs__btn--primary {
    background: var(--color-accent);
    color: var(--color-paper);
  }
  .pp-prefs__btn--ghost {
    box-shadow: inset 0 0 0 1px var(--color-rule);
    color: var(--color-ink);
  }
</style>
