---
import Logo from './logo.astro';
import { NewsletterForm } from '@/features/newsletter';
import { site } from '@/shared/site';
import { useTranslation, localize } from '@/shared/i18n';
import { getFormIdByName, NEWSLETTER_FORM_NAME } from '@/shared/wix-forms';

const year = new Date().getFullYear();
const { links } = site;
const { t } = useTranslation();

const newsletterFormId = await getFormIdByName(NEWSLETTER_FORM_NAME);

const newsletterLabels = {
  label: t('footer.newsletter.label'),
  placeholder: t('footer.newsletter.placeholder'),
  submit: t('footer.newsletter.submit'),
  sending: t('footer.newsletter.sending'),
  success: t('footer.newsletter.success'),
  error: t('footer.newsletter.error'),
  invalid: t('footer.newsletter.invalid'),
};

const columns = [
  {
    title: 'footer.shop',
    items: [
      { href: links.shop, label: 'nav.all-plants' },
      { href: '/category/carnivorous', label: 'footer.carnivorous' },
      { href: '/category/flowers', label: 'footer.flowers' },
      { href: '/category/kits-accessories', label: 'footer.kits' },
    ],
  },
  {
    title: 'footer.company',
    items: [
      { href: '/about', label: 'nav.about' },
      { href: '/contact', label: 'nav.contact' },
    ],
  },
  {
    title: 'footer.care',
    items: [
      { href: '/contact#shipping', label: 'footer.shipping' },
      { href: '/contact#care', label: 'footer.plant-care' },
    ],
  },
];
---

<footer class="relative bg-paper px-4 pt-24 pb-12 text-ink sm:px-8 lg:px-20">
  <div class="mx-auto grid max-w-6xl gap-12 md:grid-cols-2 lg:grid-cols-5">
    <div class="flex flex-col gap-4 lg:col-span-2">
      <Logo class="text-base" />
      <p class="max-w-xs text-sm leading-6 text-ink-soft">
        {t('footer.about')}
      </p>
      <a
        href={localize(links.shop)}
        class="mt-2 inline-flex h-10 w-fit items-center justify-center rounded-full bg-accent px-5 text-sm font-medium text-paper transition-colors duration-700 ease-fluid hover:bg-cream"
      >
        <span class="text-trim">{t('common.shop-the-collection')}</span>
      </a>
    </div>

    {
      columns.map((column) => (
        <div class="flex flex-col gap-3 text-sm">
          <h2 class="text-xs font-medium tracking-widest text-mute uppercase">{t(column.title)}</h2>
          <ul class="flex flex-col gap-2">
            {column.items.map((item) => (
              <li>
                <a href={localize(item.href)} class="link text-ink-soft hover:text-ink">
                  {t(item.label)}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <div class="mx-auto mt-16 max-w-6xl border-t border-rule pt-10">
    <div class="grid gap-6 lg:grid-cols-2 lg:gap-16">
      <div>
        <p class="text-xs font-medium tracking-widest text-accent uppercase">{t('footer.newsletter.eyebrow')}</p>
        <h2 class="mt-3 font-display text-2xl leading-tight text-ink lg:text-3xl">{t('footer.newsletter.title')}</h2>
        <p class="mt-2 max-w-md text-sm leading-6 text-ink-soft">{t('footer.newsletter.body')}</p>
      </div>
      <div class="lg:pt-2">
        {newsletterFormId ? (
          <NewsletterForm client:idle formId={newsletterFormId} labels={newsletterLabels} />
        ) : (
          <p class="text-sm leading-6 text-ink-soft">
            {t('footer.newsletter.empty')}{' '}
            <a href="mailto:hello@petalsandpredators.com" class="link text-accent">hello@petalsandpredators.com</a>.
          </p>
        )}
      </div>
    </div>
  </div>

  <div class="mx-auto mt-16 flex max-w-6xl flex-col gap-3 border-t border-rule pt-8 text-xs text-mute sm:flex-row sm:items-center sm:justify-between">
    <p>{t('footer.rights', { year })}</p>
    <p>{t('footer.tagline')}</p>
  </div>
</footer>
