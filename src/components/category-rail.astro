---
import type { StoreCategory } from '@/utils/categories';
import { useTranslation, localize } from '@/utils/i18n';

interface Props {
  categories: StoreCategory[];
  activeSlug: string | null;
  prevHref: string | null;
  nextHref: string | null;
}

const { categories, activeSlug, prevHref, nextHref } = Astro.props;
const { t } = useTranslation();

const pillBase =
  'inline-flex h-9 items-center rounded-full px-4 text-sm font-medium whitespace-nowrap transition-colors duration-500 ease-fluid';
const pillActive = 'bg-accent text-paper';
const pillIdle = 'border border-rule text-ink-soft hover:border-accent/40 hover:text-ink';
---

{
  categories.length > 0 && (
    <nav class="relative z-2 bg-paper px-4 py-4 sm:px-8 lg:px-20" aria-label={t('shop.browse-category')} data-category-rail>
      <div class="mx-auto flex max-w-6xl gap-2 overflow-x-auto pb-1">
        <a
          href={localize('/products')}
          class={`${pillBase} ${activeSlug ? pillIdle : pillActive}`}
          data-category-slug=""
          aria-current={activeSlug ? undefined : 'page'}
        >
          {t('shop.all')}
        </a>
        {categories.map((cat) => (
          <a
            href={localize(`/category/${cat.slug}`)}
            class={`${pillBase} ${activeSlug === cat.slug ? pillActive : pillIdle}`}
            data-category-slug={cat.slug}
            aria-current={activeSlug === cat.slug ? 'page' : undefined}
          >
            {cat.name}
          </a>
        ))}
      </div>
    </nav>
  )
}

{
  (prevHref || nextHref) && (
    <nav class="relative z-2 bg-paper px-4 pb-8 sm:px-8 lg:px-20" aria-label={t('shop.pagination')}>
      <div class="mx-auto flex max-w-6xl items-center justify-between text-sm">
        {prevHref ? (
          <a href={prevHref} class="text-ink-soft transition-colors hover:text-accent" rel="prev">
            &larr; {t('shop.previous')}
          </a>
        ) : (
          <span class="text-mute/50" aria-disabled="true">
            &larr; {t('shop.previous')}
          </span>
        )}
        {nextHref ? (
          <a href={nextHref} class="text-ink-soft transition-colors hover:text-accent" rel="next">
            {t('shop.next')} &rarr;
          </a>
        ) : (
          <span class="text-mute/50" aria-disabled="true">
            {t('shop.next')} &rarr;
          </span>
        )}
      </div>
    </nav>
  )
}
