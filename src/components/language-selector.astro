---
import { LOCALES, currentLanguage, localeUrl, useTranslation } from '@/utils/i18n';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
const { t } = useTranslation();
const current = currentLanguage();
const path = Astro.url.pathname;

const names: Record<string, string> = { en: 'English', es: 'Español', it: 'Italiano' };
const codes: Record<string, string> = { en: 'EN', es: 'ES', it: 'IT' };
---

<details class:list={['lang-selector relative', className]}>
  <summary
    class="flex h-9 cursor-pointer list-none items-center gap-1 rounded-full px-3 text-sm text-ink-soft transition-colors duration-700 ease-fluid hover:text-ink"
    aria-label={`${t('header.language')}: ${names[current]}`}
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-4" aria-hidden="true">
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"></path>
    </svg>
    <span class="text-trim" aria-hidden="true">{codes[current]}</span>
    <svg
      viewBox="0 0 16 16"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      class="lang-chevron size-3 transition-transform duration-300 ease-fluid"
      aria-hidden="true"
    >
      <path d="m4 6 4 4 4-4"></path>
    </svg>
  </summary>

  <ul
    class="absolute top-[calc(100%+0.5rem)] right-0 z-50 min-w-40 rounded-md border border-rule bg-paper p-1 shadow-lg"
  >
    {
      LOCALES.map((locale) => (
        <li>
          <a
            href={localeUrl(path, locale)}
            hreflang={locale}
            lang={locale}
            aria-current={locale === current ? 'true' : undefined}
            class="flex items-center justify-between rounded-sm px-3 py-2 text-sm text-ink-soft transition-colors hover:bg-ink/5 hover:text-ink aria-[current=true]:text-ink"
          >
            <span>{names[locale]}</span>
            <span class="text-xs text-mute">{codes[locale]}</span>
          </a>
        </li>
      ))
    }
  </ul>
</details>

<style>
  .lang-selector summary::-webkit-details-marker {
    display: none;
  }

  .lang-selector[open] .lang-chevron {
    transform: rotate(180deg);
  }
</style>

<script>
  const close = (selector: string) => {
    document.querySelectorAll<HTMLDetailsElement>(selector).forEach((el) => el.removeAttribute('open'));
  };

  document.addEventListener('click', (event) => {
    const target = event.target as Element | null;
    document.querySelectorAll<HTMLDetailsElement>('.lang-selector[open]').forEach((el) => {
      if (!target?.closest('.lang-selector')) el.removeAttribute('open');
    });
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') close('.lang-selector[open]');
  });
</script>
