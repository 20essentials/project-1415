---
import Logo from '@/components/logo.astro';
import { site } from '@/data/site';

const year = new Date().getFullYear();
const { links } = site;

const columns = [
  {
    title: 'Shop',
    items: [
      { href: links.shop, label: 'All plants' },
      { href: '/category/carnivorous', label: 'Carnivorous' },
      { href: '/category/flowers', label: 'Flowers' },
      { href: '/category/kits-accessories', label: 'Kits & accessories' },
    ],
  },
  {
    title: 'Company',
    items: [
      { href: '/about', label: 'About' },
      { href: '/contact', label: 'Contact' },
    ],
  },
  {
    title: 'Care',
    items: [
      { href: '/contact#shipping', label: 'Shipping & returns' },
      { href: '/contact#care', label: 'Plant care 101' },
    ],
  },
];
---

<footer class="relative bg-paper px-4 pt-24 pb-12 text-ink sm:px-8 lg:px-20">
  <div class="mx-auto grid max-w-6xl gap-12 md:grid-cols-2 lg:grid-cols-5">
    <div class="flex flex-col gap-4 lg:col-span-2">
      <Logo class="text-base" />
      <p class="max-w-xs text-sm leading-6 text-ink-soft">
        Carnivorous specimens, show-stopping blooms, and care-tested kits — greenhouse-grown and shipped alive to your
        door.
      </p>
      <a
        href={links.shop}
        class="mt-2 inline-flex h-10 w-fit items-center justify-center rounded-full bg-accent px-5 text-sm font-medium text-paper transition-colors duration-700 ease-fluid hover:bg-cream"
      >
        <span class="text-trim">Shop the collection</span>
      </a>
    </div>

    {
      columns.map((column) => (
        <div class="flex flex-col gap-3 text-sm">
          <h2 class="text-xs font-medium tracking-widest text-mute uppercase">{column.title}</h2>
          <ul class="flex flex-col gap-2">
            {column.items.map((item) => (
              <li>
                <a href={item.href} class="link text-ink-soft hover:text-ink">
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <div class="mx-auto mt-16 flex max-w-6xl flex-col gap-3 border-t border-rule pt-8 text-xs text-mute sm:flex-row sm:items-center sm:justify-between">
    <p>© {year} Petals & Predators. All rights reserved.</p>
    <p>Greenhouse-grown in-house · shipped worldwide.</p>
  </div>
</footer>
