---
import Layout from '@/app/layout.astro';
import ProductCard from '@/features/product-catalog/product-card.astro';
import CategoryRail from '@/features/product-catalog/category-rail.astro';
import CatalogToolbar from '@/features/product-catalog/catalog-toolbar.astro';
import { WIX_APPS } from '@wix/essentials';
import { SEO } from '@wix/seo/components';
import { loadSEOTagsServiceConfig } from '@wix/seo/services';
import { seoTags } from '@wix/seo';
import {
  getCategoryBySlug,
  listProductsInCategory,
  listStoreCategories,
} from '@/features/product-catalog/categories';
import { listWishlist } from '@/features/wishlist/wishlist';
import { members } from '@wix/members';
import {
  buildCatalogHref,
  DEFAULT_CATALOG_QUERY,
  filterCatalogItems,
  isCatalogFiltered,
  parseCatalogQuery,
  sortCatalogItems,
} from '@/features/product-catalog/catalog-filters';
import { toMetaDescription } from '@/shared/seo';
import { useTranslation, localize, currentLanguage } from '@/shared/i18n';
import AnalyticsView from '@/shared/analytics-view.astro';

export const wixMetadata = {
  appDefId: WIX_APPS.checkoutAndOrders.id,
  pageIdentifier: WIX_APPS.checkoutAndOrders.categoryPageMetadata.pageIdentifier,
  identifiers: { slug: WIX_APPS.checkoutAndOrders.categoryPageMetadata.identifiers.collection },
};

const { t } = useTranslation();

const PAGE_SIZE = 24;
const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect(localize('/products'));
}

const forwardedUrl = Astro.request.headers.get('x-wix-forwarded-url');
const pageUrl =
  forwardedUrl && URL.canParse(forwardedUrl) && /^https?:$/.test(new URL(forwardedUrl).protocol)
    ? forwardedUrl
    : Astro.url.href;

const [category, seoTagsServiceConfig] = await Promise.all([
  getCategoryBySlug(slug),
  loadSEOTagsServiceConfig({
    pageUrl,
    itemType: seoTags.ItemType.STORES_CATEGORY,
    itemData: { slug },
  }),
]);

if (!category) {
  return new Response('Category not found', { status: 404 });
}

const cursor = Astro.url.searchParams.get('cursor') ?? undefined;
const page = await listProductsInCategory(category.id, { limit: PAGE_SIZE, cursor });

const query = parseCatalogQuery(Astro.url.searchParams);
const productList = sortCatalogItems(
  filterCatalogItems(
    page.items.filter((product) => product.ribbon?.name !== 'Gift Card'),
    query.availability,
  ),
  query.sort,
  currentLanguage(),
);

const categories = await listStoreCategories();

let memberId = '';
try {
  const res = await members.getCurrentMember({ fieldsets: ['FULL'] });
  memberId = res.member?._id ?? '';
} catch {
  memberId = '';
}
const wishedIds = new Set((await listWishlist(memberId)).map((item) => item.productId));

const metaDescription = toMetaDescription(
  category.description,
  t('category.meta-description', { name: category.name }),
);

function pageHref(next: string | null): string | null {
  if (!next) return null;
  return buildCatalogHref(localize(`/category/${category!.slug}`), query, { cursor: next });
}
---

<Layout>
  <AnalyticsView
    event="CustomEvent"
    payload={{ eventCategory: 'Category', eventAction: 'ViewCategory', eventLabel: category.name }}
  />
  <SEO.Tags seoTagsServiceConfig={seoTagsServiceConfig} slot="seo-tags" />
  <Fragment slot="head">
    <meta name="description" content={metaDescription} />
    <meta property="og:description" content={metaDescription} />
  </Fragment>
  <section class="relative z-2 bg-paper px-4 pt-24 pb-10 text-ink sm:px-8 lg:px-20 lg:pt-28">
    <div class="mx-auto max-w-6xl">
      <nav class="text-xs text-ink-soft" aria-label="Breadcrumb">
        <a href={localize('/')} class="transition-colors hover:text-accent">{t('nav.home')}</a>
        <span aria-hidden="true"> &middot; </span>
        <a href={localize('/products')} class="transition-colors hover:text-accent">{t('shop.eyebrow')}</a>
        <span aria-hidden="true"> &middot; </span>
        <span class="text-ink" aria-current="page">{category.name}</span>
      </nav>
      <h1 class="mt-6 font-display text-4xl leading-tight text-ink lg:text-5xl">{category.name}</h1>
      {
        category.description && (
          <p class="mt-4 max-w-xl text-sm leading-6 text-ink-soft">{category.description}</p>
        )
      }
    </div>
  </section>

  <CategoryRail
    categories={categories}
    activeSlug={category.slug}
    prevHref={pageHref(page.prevCursor)}
    nextHref={pageHref(page.nextCursor)}
  />

  <CatalogToolbar
    query={query}
    resultCount={productList.length}
    clearHref={
      isCatalogFiltered(query)
        ? buildCatalogHref(localize(`/category/${category.slug}`), DEFAULT_CATALOG_QUERY)
        : null
    }
  />

  <section class="relative z-2 bg-paper px-4 pb-24 sm:px-8 lg:px-20 lg:pb-32">
    <div class="mx-auto max-w-6xl">
      <h2 class="sr-only">{t('category.plants-in', { name: category.name })}</h2>
      {
        productList.length > 0 ? (
          <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3 xl:grid-cols-4">
            {productList.map((product, index) => (
              <ProductCard
                product={product}
                index={index}
                isMember={Boolean(memberId)}
                wished={wishedIds.has(product._id ?? '')}
              />
            ))}
          </ul>
        ) : (
          <p class="max-w-xl text-sm leading-6 text-ink-soft">
            {t('category.empty', { name: category.name })}{' '}
            <a href={localize('/products')} class="text-accent underline">{t('category.browse-all')}</a>.
          </p>
        )
      }
    </div>
  </section>
</Layout>
