---
import Layout from '@/layouts/layout.astro';

const story = [
  'Petals & Predators started with a single Venus flytrap on a kitchen windowsill — and the small shock of watching it actually catch a fly. That curiosity grew into a greenhouse, and the greenhouse grew into a boutique built around two things that rarely share a shelf: carnivorous plants and flowers with real character.',
  'We are a small team of growers who believe a plant should be interesting before it is pretty. Some of ours bite. Others bloom. All of them are chosen because they bring something alive and a little unexpected into a room.',
  'Every specimen is grown in-house, packed by hand, and shipped with the care it needs to arrive thriving. If it does not, we make it right — that part is a promise, not a slogan.',
];

const values = [
  {
    title: 'Hand-pollinated',
    body: 'Our blooms are pollinated by hand so each seed carries the traits we actually want — colour, vigour, and a healthy appetite.',
  },
  {
    title: 'Peat-based mixes',
    body: 'We grow in nutrient-poor, peat-based substrate mixed to each species, never regular potting soil that burns their roots.',
  },
  {
    title: 'Ventilated boxes',
    body: 'Plants travel in ventilated boxes with a moisture collar, so they arrive hydrated, upright, and ready to grow.',
  },
];

const stats = [
  { value: '5', label: 'Care-tested species' },
  { value: '48h', label: 'Dispatch window' },
  { value: '30 days', label: 'Live-arrival guarantee' },
];
---

<Layout
  title="About — Petals & Predators"
  description="A greenhouse boutique for carnivorous plants and flowers with character — grown in-house, packed by hand, and shipped alive."
>
  <section class="relative z-2 bg-paper px-4 pt-24 pb-10 text-ink sm:px-8 lg:px-20 lg:pt-32">
    <div class="mx-auto max-w-6xl">
      <nav class="text-sm text-ink-soft" aria-label="Breadcrumb">
        <a href="/" class="transition-colors hover:text-accent">Home</a>
        <span aria-hidden="true"> · </span>
        <span aria-current="page" class="text-ink">About</span>
      </nav>
      <p class="mt-6 text-xs font-medium tracking-widest text-accent uppercase">About</p>
      <h1 class="mt-3 max-w-3xl font-display text-4xl leading-tight text-ink lg:text-5xl">
        A greenhouse boutique for plants with teeth — and flowers with character.
      </h1>
      <p class="mt-4 max-w-xl text-sm leading-6 text-ink-soft">
        Carnivorous specimens, show-stopping blooms, and care-tested kits, grown in-house and
        shipped alive to your door.
      </p>
    </div>
  </section>

  <section class="relative z-2 bg-paper px-4 py-24 sm:px-8 lg:px-20 lg:py-32">
    <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-2 lg:gap-16">
      <div class="container mx-auto max-w-2xl">
        <p class="text-xs font-medium tracking-widest text-accent uppercase">Our story</p>
        <h2 class="mt-3 font-display text-3xl leading-tight text-ink lg:text-4xl">
          Interesting before pretty.
        </h2>
        <div class="mt-6 flex flex-col gap-4">
          {story.map((paragraph) => <p class="text-sm leading-7 text-ink-soft">{paragraph}</p>)}
        </div>
      </div>

      <div
        class="flex aspect-4/5 items-center justify-center rounded-lg border border-rule bg-paper-warm"
        role="img"
        aria-label="Editorial illustration of a carnivorous plant in the greenhouse"
      >
        <span aria-hidden="true" class="font-display text-7xl text-accent/30">❀</span>
      </div>
    </div>
  </section>

  <section class="relative z-2 border-t border-rule bg-paper px-4 py-24 sm:px-8 lg:px-20 lg:py-32">
    <div class="mx-auto max-w-6xl">
      <p class="text-xs font-medium tracking-widest text-accent uppercase">How we grow</p>
      <h2 class="mt-3 font-display text-3xl leading-tight text-ink lg:text-4xl">
        Grown slowly, shipped carefully.
      </h2>
      <ul class="mt-10 grid gap-6 sm:grid-cols-3">
        {
          values.map((value) => (
            <li class="rounded-md border border-rule bg-paper-warm/40 p-6">
              <h3 class="font-display text-lg text-ink">{value.title}</h3>
              <p class="mt-2 text-sm leading-6 text-ink-soft">{value.body}</p>
            </li>
          ))
        }
      </ul>

      <dl class="mt-12 grid gap-6 border-t border-rule pt-10 sm:grid-cols-3">
        {
          stats.map((stat) => (
            <div>
              <dt class="font-display text-3xl text-ink">{stat.value}</dt>
              <dd class="mt-1 text-xs font-medium tracking-widest text-mute uppercase">{stat.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="relative z-2 border-t border-rule bg-paper px-4 py-24 sm:px-8 lg:px-20 lg:py-32">
    <div class="mx-auto flex max-w-6xl flex-col items-start gap-6">
      <h2 class="max-w-xl font-display text-3xl leading-tight text-ink lg:text-4xl">
        Pick a plant, skip the guesswork.
      </h2>
      <p class="max-w-xl text-sm leading-6 text-ink-soft">
        Browse the collection and let us ship something alive and a little unexpected to your door.
      </p>
      <a
        href="/products"
        class="inline-flex h-11 items-center justify-center rounded-full bg-accent px-6 text-sm font-medium text-paper transition-colors duration-700 ease-fluid hover:bg-cream"
      >
        <span class="text-trim">Shop the collection</span>
      </a>
    </div>
  </section>
</Layout>
