---
import Layout from '@/app/layout.astro';
import { useTranslation, localize } from '@/shared/i18n';

const { t } = useTranslation();

const story = ['about.story.p1', 'about.story.p2', 'about.story.p3'];

const values = [
  { title: 'about.grow.value-1.title', body: 'about.grow.value-1.body' },
  { title: 'about.grow.value-2.title', body: 'about.grow.value-2.body' },
  { title: 'about.grow.value-3.title', body: 'about.grow.value-3.body' },
];

const stats = [
  { value: '5', label: 'about.stat-1.label' },
  { value: '48h', label: 'about.stat-2.label' },
  { value: '30 days', label: 'about.stat-3.label' },
];
---

<Layout>
  <section class="relative z-2 bg-paper px-4 pt-24 pb-10 text-ink sm:px-8 lg:px-20 lg:pt-32">
    <div class="mx-auto max-w-6xl">
      <nav class="text-sm text-ink-soft" aria-label="Breadcrumb">
        <a href={localize('/')} class="transition-colors hover:text-accent">{t('nav.home')}</a>
        <span aria-hidden="true"> · </span>
        <span aria-current="page" class="text-ink">{t('nav.about')}</span>
      </nav>
      <p class="mt-6 text-xs font-medium tracking-widest text-accent uppercase">{t('nav.about')}</p>
      <h1 class="mt-3 max-w-3xl font-display text-4xl leading-tight text-ink lg:text-5xl">
        {t('about.hero.title')}
      </h1>
      <p class="mt-4 max-w-xl text-sm leading-6 text-ink-soft">
        {t('about.hero.body')}
      </p>
    </div>
  </section>

  <section class="relative z-2 bg-paper px-4 py-24 sm:px-8 lg:px-20 lg:py-32">
    <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-2 lg:gap-16">
      <div class="container mx-auto max-w-2xl">
        <p class="text-xs font-medium tracking-widest text-accent uppercase">{t('about.story.eyebrow')}</p>
        <h2 class="mt-3 font-display text-3xl leading-tight text-ink lg:text-4xl">
          {t('about.story.title')}
        </h2>
        <div class="mt-6 flex flex-col gap-4">
          {story.map((paragraph) => <p class="text-sm leading-7 text-ink-soft">{t(paragraph)}</p>)}
        </div>
      </div>

      <div
        class="flex aspect-4/5 items-center justify-center rounded-lg border border-rule bg-paper-warm"
        role="img"
        aria-label={t('about.story.image-alt')}
      >
        <span aria-hidden="true" class="font-display text-7xl text-accent/30">❀</span>
      </div>
    </div>
  </section>

  <section class="relative z-2 border-t border-rule bg-paper px-4 py-24 sm:px-8 lg:px-20 lg:py-32">
    <div class="mx-auto max-w-6xl">
      <p class="text-xs font-medium tracking-widest text-accent uppercase">{t('about.grow.eyebrow')}</p>
      <h2 class="mt-3 font-display text-3xl leading-tight text-ink lg:text-4xl">
        {t('about.grow.title')}
      </h2>
      <ul class="mt-10 grid gap-6 sm:grid-cols-3">
        {
          values.map((value) => (
            <li class="rounded-md border border-rule bg-paper-warm/40 p-6">
              <h3 class="font-display text-lg text-ink">{t(value.title)}</h3>
              <p class="mt-2 text-sm leading-6 text-ink-soft">{t(value.body)}</p>
            </li>
          ))
        }
      </ul>

      <dl class="mt-12 grid gap-6 border-t border-rule pt-10 sm:grid-cols-3">
        {
          stats.map((stat) => (
            <div>
              <dt class="font-display text-3xl text-ink">{stat.value}</dt>
              <dd class="mt-1 text-xs font-medium tracking-widest text-mute uppercase">{t(stat.label)}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="relative z-2 border-t border-rule bg-paper px-4 py-24 sm:px-8 lg:px-20 lg:py-32">
    <div class="mx-auto flex max-w-6xl flex-col items-start gap-6">
      <h2 class="max-w-xl font-display text-3xl leading-tight text-ink lg:text-4xl">
        {t('about.cta.title')}
      </h2>
      <p class="max-w-xl text-sm leading-6 text-ink-soft">
        {t('about.cta.body')}
      </p>
      <a
        href={localize('/products')}
        class="inline-flex h-11 items-center justify-center rounded-full bg-accent px-6 text-sm font-medium text-paper transition-colors duration-700 ease-fluid hover:bg-cream"
      >
        <span class="text-trim">{t('common.shop-the-collection')}</span>
      </a>
    </div>
  </section>
</Layout>
