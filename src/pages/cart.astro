---
import Layout from '@/layouts/layout.astro';
import CartView from '@/components/cart-view.tsx';
import { useTranslation, localize } from '@/utils/i18n';

const { t } = useTranslation();

const labels = {
  title: t('cart.title'),
  loading: t('cart.loading'),
  empty: t('cart.empty'),
  continueShopping: t('cart.continue'),
  errorLoad: t('cart.error-load'),
  errorUpdate: t('cart.error-update'),
  errorRemove: t('cart.error-remove'),
  errorCheckout: t('cart.error-checkout'),
  quantityFor: t('cart.quantity-for'),
  decreaseQty: t('cart.decrease-qty'),
  increaseQty: t('cart.increase-qty'),
  remove: t('cart.remove'),
  summary: t('cart.summary'),
  subtotal: t('cart.subtotal'),
  redirecting: t('cart.redirecting'),
  checkout: t('cart.checkout'),
  product: t('cart.product-alt'),
};
---

<Layout
  title={t('cart.meta-title')}
  description={t('cart.meta-description')}
  noindex
>
  <div class='relative z-2 bg-paper px-4 pt-24 pb-16 text-ink sm:px-8 lg:px-20'>
    <CartView client:load labels={labels} continueHref={localize('/products')} thankYouPath={localize('/thank-you')} />
  </div>
</Layout>
