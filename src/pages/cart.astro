---
import Layout from '@/app/layout.astro';
import { CartView } from '@/features/cart/cart-view';
import { useTranslation, localize } from '@/shared/i18n';
import AnalyticsView from '@/shared/analytics-view.astro';

const { t } = useTranslation();

const labels = {
  title: t('cart.title'),
  loading: t('cart.loading'),
  empty: t('cart.empty'),
  continueShopping: t('cart.continue'),
  errorLoad: t('cart.error-load'),
  errorUpdate: t('cart.error-update'),
  errorRemove: t('cart.error-remove'),
  errorCheckout: t('cart.error-checkout'),
  quantityFor: t('cart.quantity-for'),
  decreaseQty: t('cart.decrease-qty'),
  increaseQty: t('cart.increase-qty'),
  remove: t('cart.remove'),
  summary: t('cart.summary'),
  subtotal: t('cart.subtotal'),
  discount: t('cart.discount'),
  total: t('cart.total'),
  redirecting: t('cart.redirecting'),
  checkout: t('cart.checkout'),
  product: t('cart.product-alt'),
  coupon: {
    label: t('cart.coupon.label'),
    placeholder: t('cart.coupon.placeholder'),
    apply: t('cart.coupon.apply'),
    applying: t('cart.coupon.applying'),
    applied: t('cart.coupon.applied'),
    remove: t('cart.coupon.remove'),
    invalid: t('cart.coupon.invalid'),
    expired: t('cart.coupon.expired'),
    already: t('cart.coupon.already'),
    giftCard: t('cart.coupon.gift-card'),
    network: t('cart.coupon.network'),
    unknown: t('cart.coupon.unknown'),
  },
};
---

<Layout noindex>
  <AnalyticsView event="CustomEvent" payload={{ eventCategory: 'Cart', eventAction: 'ViewCart' }} />
  <div class='relative z-2 bg-paper px-4 pt-24 pb-16 text-ink sm:px-8 lg:px-20'>
    <CartView client:load labels={labels} continueHref={localize('/products')} thankYouPath={localize('/thank-you')} />
  </div>
</Layout>
