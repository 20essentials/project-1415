---
import Layout from '@/app/layout.astro';
import { DonateForm } from '@/features/donations/donate-form';
import { getDonationCampaign, getDonationGoal } from '@/features/donations/donations';
import { useTranslation, localize, currentLanguage } from '@/shared/i18n';

const { t } = useTranslation();
const language = currentLanguage();

const campaign = await getDonationCampaign();
const goal = campaign ? await getDonationGoal(campaign.id) : null;

const donateLabels = {
  amountLegend: t('donations.form.amount-legend'),
  custom: t('donations.form.custom'),
  customPlaceholder: t('donations.form.custom-placeholder'),
  minimumNote: t('donations.form.minimum-note', { amount: '{{amount}}' }),
  submit: t('donations.form.submit', { amount: '{{amount}}' }),
  submitDefault: t('donations.form.submit-default'),
  submitting: t('donations.form.submitting'),
  invalid: t('donations.form.invalid'),
  error: t('donations.form.error'),
};

const progress = goal && campaign?.goalTargetAmount
  ? Math.max(0, Math.min(100, Math.round((Number(goal.raisedAmount) / Number(campaign.goalTargetAmount)) * 100)))
  : null;

const fallbackInfo = [
  { title: 'donations.fallback.info-1.title', body: 'donations.fallback.info-1.body' },
  { title: 'donations.fallback.info-2.title', body: 'donations.fallback.info-2.body' },
  { title: 'donations.fallback.info-3.title', body: 'donations.fallback.info-3.body' },
];

const heading = campaign ? campaign.name : t('donations.fallback.title');
const intro = campaign
  ? t('donations.intro')
  : t('donations.fallback.intro');
---

<Layout>
  <section class="relative z-2 bg-paper px-4 pt-32 pb-12 text-ink sm:px-8 lg:px-20 lg:pb-16">
    <div class="mx-auto max-w-6xl">
      <nav class="text-sm text-ink-soft" aria-label="Breadcrumb">
        <a href={localize('/')} class="transition-colors hover:text-accent">{t('nav.home')}</a>
        <span aria-hidden="true"> · </span>
        <span aria-current="page" class="text-ink">{t('nav.donate')}</span>
      </nav>

      <p class="mt-10 text-xs font-medium tracking-widest text-accent uppercase">{t('donations.eyebrow')}</p>
      <h1 class="mt-3 max-w-3xl font-display text-4xl leading-tight text-ink lg:text-5xl">{heading}</h1>
      <p class="mt-4 max-w-xl text-base leading-7 text-ink-soft">{intro}</p>
    </div>
  </section>

  {
    campaign ? (
      <section class="relative z-2 bg-paper px-4 pb-24 text-ink sm:px-8 lg:px-20 lg:pb-32">
        <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-5">
            {progress !== null && campaign.goalFormattedTargetAmount && (
              <div class="rounded-lg border border-rule bg-paper-warm p-6">
                <p class="text-xs font-medium tracking-widest text-mute uppercase">
                  {t('donations.progress.label')}
                </p>
                <div
                  class="mt-4 h-1.5 w-full overflow-hidden rounded-full bg-rule"
                  role="progressbar"
                  aria-valuenow={progress}
                  aria-valuemin="0"
                  aria-valuemax="100"
                  aria-label={t('donations.progress.label')}
                >
                  <div class="h-full rounded-full bg-accent transition-all duration-700 ease-fluid" style={`width: ${progress}%`} />
                </div>
                <p class="mt-3 text-sm text-ink-soft">
                  {t('donations.progress.raised', {
                    raised: goal?.formattedRaisedAmount ?? '',
                    goal: campaign.goalFormattedTargetAmount,
                  })}
                </p>
              </div>
            )}
            <p class="mt-6 text-xs leading-5 text-mute">{t('donations.fineprint')}</p>
          </div>

          <div class="lg:col-span-7 lg:self-center">
            <DonateForm
              client:load
              presets={campaign.presets}
              customAmountEnabled={campaign.customAmountEnabled}
              minimumAmount={campaign.minimumAmount}
              minimumFormattedAmount={campaign.minimumFormattedAmount}
              language={language}
              labels={donateLabels}
            />
          </div>
        </div>
      </section>
    ) : (
      <section class="relative z-2 bg-paper px-4 pb-24 text-ink sm:px-8 lg:px-20 lg:pb-32">
        <div class="mx-auto max-w-6xl">
          <ul class="grid grid-cols-1 gap-6 md:grid-cols-3">
            {fallbackInfo.map((item) => (
              <li class="flex flex-col gap-2 rounded-md border border-rule bg-paper-warm p-6">
                <h2 class="font-display text-lg leading-tight text-ink">{t(item.title)}</h2>
                <p class="text-sm leading-6 text-ink-soft">{t(item.body)}</p>
              </li>
            ))}
          </ul>

          <div class="mt-12 flex flex-col items-start gap-4 rounded-lg border border-rule bg-paper-warm p-8 sm:flex-row sm:items-center sm:justify-between lg:p-12">
            <p class="max-w-md text-sm leading-6 text-ink-soft">{t('donations.fallback.cta-note')}</p>
            <a
              href={localize('/contact')}
              class="inline-flex h-11 shrink-0 items-center justify-center rounded-full bg-accent px-6 text-sm font-medium text-paper transition-colors duration-700 ease-fluid hover:bg-cream"
            >
              <span class="text-trim">{t('donations.fallback.cta')}</span>
            </a>
          </div>
        </div>
      </section>
    )
  }
</Layout>
