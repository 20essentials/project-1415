---
import Layout from '@/app/layout.astro';
import ProductCard from '@/features/product-catalog/product-card.astro';
import CategoryRail from '@/features/product-catalog/category-rail.astro';
import CatalogToolbar from '@/features/product-catalog/catalog-toolbar.astro';
import { productsV3 } from '@wix/stores';
import { members } from '@wix/members';
import type { V3Product } from '@wix/auto_sdk_stores_products-v-3';
import { listStoreCategories } from '@/features/product-catalog/categories';
import { listWishlist } from '@/features/wishlist/wishlist';
import {
  buildCatalogHref,
  filterCatalogItems,
  isCatalogFiltered,
  parseCatalogQuery,
  sortCatalogItems,
} from '@/features/product-catalog/catalog-filters';
import { useTranslation, localize, currentLanguage } from '@/shared/i18n';

const { t } = useTranslation();

const PAGE_SIZE = 24;

let productList: V3Product[] = [];
let nextCursor: string | null = null;
let prevCursor: string | null = null;

try {
  const result = await productsV3
    .queryProducts({ fields: ['CURRENCY', 'MIN_PRICE_VARIANT', 'DISCOUNT_INFO'] })
    .limit(PAGE_SIZE)
    .find();
  productList = result.items ?? [];
  nextCursor = result.cursors?.next ?? null;
  prevCursor = result.cursors?.prev ?? null;
} catch (error) {
  console.error('[products] listing query failed:', error);
}

productList = productList.filter((product) => product.ribbon?.name !== 'Gift Card');

const query = parseCatalogQuery(Astro.url.searchParams);
productList = sortCatalogItems(
  filterCatalogItems(productList, query.availability),
  query.sort,
  currentLanguage(),
);

const categories = await listStoreCategories();

let memberId = '';
try {
  const res = await members.getCurrentMember({ fieldsets: ['FULL'] });
  memberId = res.member?._id ?? '';
} catch {
  memberId = '';
}
const wishedIds = new Set((await listWishlist(memberId)).map((item) => item.productId));

function pageHref(cursor: string | null): string | null {
  if (!cursor) return null;
  return buildCatalogHref(localize('/products'), query, { cursor });
}
---

<Layout>
  <section class="relative z-2 bg-paper px-4 pt-24 pb-10 text-ink sm:px-8 lg:px-20 lg:pt-32">
    <div class="mx-auto max-w-6xl">
      <nav class="text-sm text-ink-soft" aria-label="Breadcrumb">
        <a href={localize('/')} class="transition-colors hover:text-accent">{t('nav.home')}</a>
        <span aria-hidden="true"> · </span>
        <span aria-current="page" class="text-ink">{t('shop.eyebrow')}</span>
      </nav>
      <p class="mt-6 text-xs font-medium tracking-widest text-accent uppercase">{t('shop.eyebrow')}</p>
      <h1 class="mt-3 font-display text-4xl leading-tight text-ink lg:text-5xl">{t('nav.all-plants')}</h1>
      <p class="mt-4 max-w-xl text-sm leading-6 text-ink-soft">
        {t('shop.hero.body')}
      </p>
    </div>
  </section>

  <CategoryRail
    categories={categories}
    activeSlug={null}
    prevHref={pageHref(prevCursor)}
    nextHref={pageHref(nextCursor)}
  />

  <CatalogToolbar
    query={query}
    resultCount={productList.length}
    clearHref={isCatalogFiltered(query) ? localize('/products') : null}
  />

  <section class="relative z-2 bg-paper px-4 pb-24 sm:px-8 lg:px-20 lg:pb-32">
    <div class="mx-auto max-w-6xl">
      <h2 class="sr-only">{t('nav.all-plants')}</h2>
      <script is:inline>
        (function () {
          try {
            if (typeof window === 'undefined') return;
            var grid = document.querySelector('[data-product-grid]');
            if (!grid) return;
            var items = [];
            grid.querySelectorAll('[data-product-card]').forEach(function (el, idx) {
              if (idx >= 12) return;
              items.push({
                id: el.getAttribute('data-product-id') || undefined,
                name: el.getAttribute('data-product-name') || undefined,
                price: el.getAttribute('data-product-price') || undefined,
                position: idx + 1,
              });
            });
            if (items.length === 0) return;
            window.addEventListener('load', function () {
              try {
                import('/src/shared/analytics.ts').then(function (mod) {
                  if (mod && typeof mod.trackEvent === 'function') {
                    mod.trackEvent('AddProductImpression', { items: items });
                  }
                }).catch(function () {});
              } catch (e) {}
            }, { once: true });
            grid.addEventListener('click', function (e) {
              var link = e.target && e.target.closest ? e.target.closest('[data-product-link]') : null;
              if (!link) return;
              var card = link.closest('[data-product-card]');
              if (!card) return;
              try {
                import('/src/shared/analytics.ts').then(function (mod) {
                  if (mod && typeof mod.trackEvent === 'function') {
                    mod.trackEvent('ClickProduct', {
                      id: card.getAttribute('data-product-id') || undefined,
                      name: card.getAttribute('data-product-name') || undefined,
                      price: card.getAttribute('data-product-price') || undefined,
                    });
                  }
                }).catch(function () {});
              } catch (e2) {}
            });
          } catch (e) {}
        })();
      </script>
      {
        productList.length > 0 ? (
          <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3 xl:grid-cols-4" data-product-grid>
            {productList.map((product, index) => (
              <ProductCard
                product={product}
                index={index}
                isMember={Boolean(memberId)}
                wished={wishedIds.has(product._id ?? '')}
              />
            ))}
          </ul>
        ) : (
          <p class="max-w-xl text-sm leading-6 text-ink-soft">
            {t('shop.empty')} <a href={localize('/')} class="text-accent underline">{t('shop.back-home')}</a>.
          </p>
        )
      }
    </div>
  </section>
</Layout>
