---
import Layout from '@/app/layout.astro';
import { members } from '@wix/members';
import { resolveMemberAvatarUrl } from '@/features/account';
import { localize, currentLanguage, useTranslation } from '@/shared/i18n';
import type { Member } from '@wix/auto_sdk_members_members';

const { t } = useTranslation();

type CurrentMember = Member;

let member: CurrentMember | null = null;
try {
  const res = await members.getCurrentMember({ fieldsets: ['FULL'] });
  member = res.member ?? null;
} catch {
  member = null;
}

if (!member) {
  return Astro.redirect(localize(`/api/auth/login?returnToUrl=${localize('/account')}`));
}

const contactName = [member.contact?.firstName, member.contact?.lastName]
  .filter((part): part is string => Boolean(part))
  .join(' ');
const displayName = member.profile?.nickname?.trim() || contactName || member.loginEmail || t('account.member');
const initials = displayName.charAt(0).toUpperCase();
const photoUrl = await resolveMemberAvatarUrl(member, 192, 192);

const createdDate = member._createdDate ? new Date(member._createdDate) : null;
const memberSince =
  createdDate && !Number.isNaN(createdDate.getTime())
    ? new Intl.DateTimeFormat(currentLanguage(), { month: 'long', year: 'numeric' }).format(createdDate)
    : null;
---

<Layout noindex>
  <section class="relative z-2 bg-paper px-4 pt-24 pb-24 text-ink sm:px-8 lg:px-20 lg:pt-32 lg:pb-32">
    <div class="mx-auto max-w-2xl">
      <nav class="text-sm text-ink-soft" aria-label="Breadcrumb">
        <a href={localize('/')} class="transition-colors hover:text-accent">{t('nav.home')}</a>
        <span aria-hidden="true"> · </span>
        <span aria-current="page" class="text-ink">{t('account.eyebrow')}</span>
      </nav>

      <p class="mt-6 text-xs font-medium tracking-widest text-accent uppercase">{t('account.eyebrow')}</p>
      <h1 class="mt-3 font-display text-4xl leading-tight text-ink lg:text-5xl">
        {t('account.welcome', { name: displayName })}
      </h1>
      <p class="mt-4 max-w-xl text-sm leading-6 text-ink-soft">
        {t('account.intro')}
      </p>

      <div class="mt-10 rounded-md border border-rule bg-paper-warm/40 p-6 sm:p-8">
        <div class="flex items-center gap-5">
          {
            photoUrl && (
              <img
                src={photoUrl}
                width="96"
                height="96"
                alt=""
                loading="lazy"
                decoding="async"
                referrerpolicy="no-referrer"
                onerror="this.hidden=true;this.nextElementSibling.hidden=false"
                class="size-24 shrink-0 rounded-full border border-rule object-cover"
              />
            )
          }
          <span
            aria-hidden="true"
            hidden={Boolean(photoUrl)}
            class="flex size-24 shrink-0 items-center justify-center rounded-full border border-rule bg-paper font-display text-3xl text-accent"
          >
            {initials}
          </span>
          <div class="min-w-0">
            <h2 class="font-display text-2xl text-ink">{displayName}</h2>
            {contactName && contactName !== displayName && (
              <p class="mt-1 text-sm text-ink-soft">{contactName}</p>
            )}
            {member.loginEmail && <p class="mt-1 truncate text-sm text-mute">{member.loginEmail}</p>}
          </div>
        </div>

        <dl class="mt-8 grid gap-4 border-t border-rule pt-6 sm:grid-cols-2">
          <div>
            <dt class="text-xs font-medium tracking-widest text-mute uppercase">{t('account.email')}</dt>
            <dd class="mt-1 truncate text-sm text-ink">{member.loginEmail ?? '—'}</dd>
          </div>
          <div>
            <dt class="text-xs font-medium tracking-widest text-mute uppercase">{t('account.member-since')}</dt>
            <dd class="mt-1 text-sm text-ink">{memberSince ?? '—'}</dd>
          </div>
        </dl>

        <div class="mt-8 flex flex-wrap items-center justify-between gap-4 border-t border-rule pt-6">
          <a href={localize('/account/orders')} class="text-sm text-accent transition-colors hover:underline">
            {t('account.order-history')}
          </a>
          <form method="POST" action={`/api/auth/logout?returnToUrl=${localize('/')}`}>
            <button type="submit" class="btn btn-ghost">
              <span class="text-trim">{t('account.log-out')}</span>
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>
</Layout>
