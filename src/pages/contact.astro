---
import Layout from '@/layouts/layout.astro';
import ContactForm, { type ContactFormField } from '@/components/contact-form.tsx';
import { forms } from '@wix/forms';
import { auth } from '@wix/essentials';
import { useTranslation, localize } from '@/utils/i18n';

const { t } = useTranslation();

const elevatedListForms = auth.elevate(forms.listForms);

let formId = '';
let fields: ContactFormField[] = [];

try {
  const result = await elevatedListForms('wix.form_app.form');
  const wixForm = result.forms?.[0];
  formId = wixForm?._id ?? '';
  fields = (wixForm?.formFields ?? [])
    .filter((field) => field.fieldType === 'INPUT' && !field.hidden)
    .map((field) => {
      const options = field.inputOptions;
      const string = options?.stringOptions;
      const label =
        string?.textInputOptions?.label ??
        string?.dropdownOptions?.label ??
        string?.phoneInputOptions?.label ??
        '';
      return {
        label,
        target: options?.target ?? '',
        required: options?.required ?? false,
        componentType: string?.componentType ?? 'TEXT_INPUT',
        identifier: field.identifier ?? '',
        options: string?.dropdownOptions?.options?.map((option) => ({
          value: option.value ?? option.label ?? '',
          label: option.label ?? option.value ?? '',
        })),
      };
    })
    .filter((field) => field.target);
} catch (error) {
  console.error('[contact] form discovery failed:', error);
}

const contactDetails: { label: string; value: string; href?: string }[] = [
  { label: t('account.email'), value: 'hello@petalsandpredators.com', href: 'mailto:hello@petalsandpredators.com' },
  { label: t('contact.hours-label'), value: 'Mon–Fri · 9:00–17:00 CET' },
  { label: t('contact.instagram-label'), value: '@petalsandpredators', href: 'https://www.instagram.com/petalsandpredators' },
];

const shipping = [
  { title: 'contact.shipping.1.title', body: 'contact.shipping.1.body' },
  { title: 'contact.shipping.2.title', body: 'contact.shipping.2.body' },
  { title: 'contact.shipping.3.title', body: 'contact.shipping.3.body' },
];

const careTips = [
  { title: 'contact.care.tip-1.title', body: 'contact.care.tip-1.body' },
  { title: 'contact.care.tip-2.title', body: 'contact.care.tip-2.body' },
  { title: 'contact.care.tip-3.title', body: 'contact.care.tip-3.body' },
  { title: 'contact.care.tip-4.title', body: 'contact.care.tip-4.body' },
];

const formLabels = {
  successTitle: t('contact-form.success-title'),
  successBody: t('contact-form.success-body'),
  sending: t('contact-form.sending'),
  send: t('contact-form.send'),
  error: t('contact-form.error'),
  invalid: t('contact-form.invalid'),
};
---

<Layout>
  <section class="relative z-2 bg-paper px-4 pt-24 pb-10 text-ink sm:px-8 lg:px-20 lg:pt-32">
    <div class="mx-auto max-w-6xl">
      <nav class="text-sm text-ink-soft" aria-label="Breadcrumb">
        <a href={localize('/')} class="transition-colors hover:text-accent">{t('nav.home')}</a>
        <span aria-hidden="true"> · </span>
        <span aria-current="page" class="text-ink">{t('nav.contact')}</span>
      </nav>
      <p class="mt-6 text-xs font-medium tracking-widest text-accent uppercase">{t('nav.contact')}</p>
      <h1 class="mt-3 font-display text-4xl leading-tight text-ink lg:text-5xl">{t('contact.hero.title')}</h1>
      <p class="mt-4 max-w-xl text-sm leading-6 text-ink-soft">
        {t('contact.hero.body')}
      </p>
    </div>
  </section>

  <section class="relative z-2 bg-paper px-4 pb-24 sm:px-8 lg:px-20 lg:pb-32">
    <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-2 lg:gap-16">
      <div class="rounded-lg border border-rule bg-paper-warm/40 p-6 sm:p-8">
        <h2 class="font-display text-2xl text-ink">{t('contact.form-title')}</h2>
        <p class="mt-2 mb-6 text-sm leading-6 text-ink-soft">
          {t('contact.form-intro')}
        </p>
        {
          formId ? (
            <ContactForm client:load formId={formId} fields={fields} labels={formLabels} />
          ) : (
            <p class="text-sm leading-6 text-ink-soft">
              {t('contact.form-empty')}{' '}
              <a href="mailto:hello@petalsandpredators.com" class="text-accent underline">
                hello@petalsandpredators.com
              </a>
              .
            </p>
          )
        }
      </div>

      <aside class="flex flex-col gap-8">
        <div>
          <h2 class="font-display text-2xl text-ink">{t('contact.greenhouse-title')}</h2>
          <p class="mt-2 text-sm leading-6 text-ink-soft">
            {t('contact.greenhouse-body')}
          </p>
        </div>
        <dl class="flex flex-col gap-4">
          {
            contactDetails.map((item) => (
              <div class="border-t border-rule pt-4">
                <dt class="text-xs font-medium tracking-widest text-mute uppercase">{item.label}</dt>
                <dd class="mt-1 text-sm text-ink">
                  {item.href ? (
                    <a
                      href={item.href}
                      class="text-ink transition-colors hover:text-accent"
                      {...item.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
                    >
                      {item.value}
                    </a>
                  ) : (
                    item.value
                  )}
                </dd>
              </div>
            ))
          }
        </dl>
      </aside>
    </div>
  </section>

  <section id="shipping" class="relative z-2 scroll-mt-28 border-t border-rule bg-paper px-4 py-24 sm:px-8 lg:px-20 lg:py-32">
    <div class="mx-auto max-w-6xl">
      <p class="text-xs font-medium tracking-widest text-accent uppercase">{t('contact.shipping.eyebrow')}</p>
      <h2 class="mt-3 font-display text-3xl leading-tight text-ink lg:text-4xl">{t('contact.shipping.title')}</h2>
      <ul class="mt-10 grid gap-6 sm:grid-cols-3">
        {
          shipping.map((item) => (
            <li class="rounded-md border border-rule bg-paper-warm/40 p-6">
              <h3 class="font-display text-lg text-ink">{t(item.title)}</h3>
              <p class="mt-2 text-sm leading-6 text-ink-soft">{t(item.body)}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="care" class="relative z-2 border-t border-rule bg-paper px-4 py-24 sm:px-8 lg:px-20 lg:py-32">
    <div class="mx-auto max-w-6xl">
      <p class="text-xs font-medium tracking-widest text-accent uppercase">{t('contact.care.eyebrow')}</p>
      <h2 class="mt-3 font-display text-3xl leading-tight text-ink lg:text-4xl">{t('contact.care.title')}</h2>
      <p class="mt-4 max-w-xl text-sm leading-6 text-ink-soft">
        {t('contact.care.body')}
      </p>
      <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          careTips.map((tip) => (
            <li class="rounded-md border border-rule bg-paper-warm/40 p-6">
              <h3 class="font-display text-lg text-ink">{t(tip.title)}</h3>
              <p class="mt-2 text-sm leading-6 text-ink-soft">{t(tip.body)}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Layout>
