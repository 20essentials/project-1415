---
import Layout from "@/layouts/layout.astro";
---

<Layout title="Thank you — Petals & Predators" description="Thank you for your order.">
  <main class="cart-shell">
    <div class="cart-header">
      <h1>Thank you</h1>
      <p class="cart-subtle">Your order has been received.</p>
    </div>
    <div class="cart-empty">
      <p>We’ll send you an email with the next steps.</p>
      <a class="btn btn-primary" href="/products">
        <span class="text-trim">Continue shopping</span>
      </a>
    </div>
  </main>
</Layout>
