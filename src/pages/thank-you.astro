---
import Layout from "@/app/layout.astro";
import { useTranslation, localize } from '@/shared/i18n';

const { t } = useTranslation();
---

<Layout noindex>
  <div class="relative z-2 bg-paper px-4 pt-24 pb-16 text-ink sm:px-8 lg:px-20">
    <div class="cart-shell">
      <div class="cart-header">
        <h1>{t('thank-you.title')}</h1>
        <p class="cart-subtle">{t('thank-you.received')}</p>
      </div>
      <div class="cart-empty">
        <p>{t('thank-you.next-steps')}</p>
        <a class="btn btn-primary" href={localize('/products')}>
          <span class="text-trim">{t('thank-you.continue')}</span>
        </a>
      </div>
    </div>
  </div>
</Layout>
