---
import Layout from "@/app/layout.astro";
import { useTranslation, localize } from '@/shared/i18n';

const { t } = useTranslation();

const orderId = Astro.url.searchParams.get('orderId') || Astro.url.searchParams.get('orderNumber') || Astro.url.searchParams.get('transactionId');
---

<Layout noindex>
  <div class="relative z-2 bg-paper px-4 pt-24 pb-16 text-ink sm:px-8 lg:px-20">
    <div class="cart-shell">
      <div class="cart-header">
        <h1>{t('thank-you.title')}</h1>
        <p class="cart-subtle">{t('thank-you.received')}</p>
      </div>
      <div class="cart-empty">
        <p>{t('thank-you.next-steps')}</p>
        <a class="btn btn-primary" href={localize('/products')}>
          <span class="text-trim">{t('thank-you.continue')}</span>
        </a>
      </div>
    </div>
  </div>
  <script is:inline define:vars={{ orderId }}>
    (function () {
      try {
        var id = orderId;
        if (!id) return;
        // Defer to ensure analytics/consent loaded
        if (typeof window !== 'undefined') {
          window.addEventListener('load', function () {
            try {
              // Use dynamic import to respect consent gating
              import('/src/shared/analytics.ts').then(function (mod) {
                if (mod && typeof mod.trackEvent === 'function') {
                  mod.trackEvent('Purchase', {
                    transaction_id: id,
                    // value/currency/contents omitted if not available to avoid PII/excess
                  });
                }
              }).catch(function () {});
            } catch (e) {}
          }, { once: true });
        }
      } catch (e) {}
    })();
  </script>
</Layout>
