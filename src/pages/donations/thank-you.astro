---
import Layout from '@/app/layout.astro';
import { useTranslation, localize } from '@/shared/i18n';

const { t } = useTranslation();

const nextSteps = [
  { title: 'donations.thank-you.next-1.title', body: 'donations.thank-you.next-1.body' },
  { title: 'donations.thank-you.next-2.title', body: 'donations.thank-you.next-2.body' },
];
---

<Layout noindex>
  <section class="relative z-2 bg-paper px-4 pt-32 pb-24 text-ink sm:px-8 lg:px-20 lg:pb-32">
    <div class="mx-auto max-w-6xl">
      <p class="text-xs font-medium tracking-widest text-accent uppercase">{t('donations.eyebrow')}</p>
      <h1 class="mt-3 max-w-3xl font-display text-4xl leading-tight text-ink lg:text-5xl">
        {t('donations.thank-you.title')}
      </h1>
      <p class="mt-4 max-w-xl text-base leading-7 text-ink-soft">{t('donations.thank-you.body')}</p>

      <ul class="mt-12 grid max-w-4xl grid-cols-1 gap-6 sm:grid-cols-2">
        {nextSteps.map((step) => (
          <li class="flex flex-col gap-2 rounded-md border border-rule bg-paper-warm p-6">
            <h2 class="font-display text-lg leading-tight text-ink">{t(step.title)}</h2>
            <p class="text-sm leading-6 text-ink-soft">{t(step.body)}</p>
          </li>
        ))}
      </ul>

      <a
        href={localize('/products')}
        class="mt-12 inline-flex h-11 items-center justify-center rounded-full bg-accent px-6 text-sm font-medium text-paper transition-colors duration-700 ease-fluid hover:bg-cream"
      >
        <span class="text-trim">{t('donations.thank-you.cta')}</span>
      </a>
    </div>
  </section>
</Layout>
