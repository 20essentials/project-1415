---
import Layout from '@/app/layout.astro';
import { getBlogPostBySlug, relatedPosts, listBlogCategories, type BlogPost, type BlogCategory } from '@/features/blog/blog';
import { renderRicos } from '@/shared/ricos';
import { useTranslation, localize, currentLanguage } from '@/shared/i18n';
import { WIX_APPS } from '@wix/essentials';
import { SEO } from '@wix/seo/components';
import { loadSEOTagsServiceConfig } from '@wix/seo/services';
import { seoTags } from '@wix/seo';
import { ogImage } from '@/shared/og-image';

export const wixMetadata = {
  appDefId: WIX_APPS.blogs.id,
  pageIdentifier: WIX_APPS.blogs.postPageMetadata.pageIdentifier,
  identifiers: { slug: WIX_APPS.blogs.postPageMetadata.identifiers.slug },
};

const { t } = useTranslation();

const slug = Astro.params.slug ?? '';
const forwardedUrl = Astro.request.headers.get('x-wix-forwarded-url');
const pageUrl =
  forwardedUrl && URL.canParse(forwardedUrl) && /^https?:$/.test(new URL(forwardedUrl).protocol)
    ? forwardedUrl
    : Astro.url.href;

const [post, seoTagsServiceConfig] = await Promise.all([
  getBlogPostBySlug(slug),
  loadSEOTagsServiceConfig({
    pageUrl,
    itemType: seoTags.ItemType.BLOG_POST,
    itemData: { slug },
  }),
]);

const seoTagsResolved = seoTagsServiceConfig.tags.length > 0;

if (!post) {
  Astro.response.status = 404;
}

const bodyHtml = post ? renderRicos(post.richContent) : '';

const published = post?.firstPublishedDate
  ? new Intl.DateTimeFormat(currentLanguage(), { month: 'long', day: 'numeric', year: 'numeric' }).format(
      post.firstPublishedDate,
    )
  : null;

let related: BlogPost[] = [];
if (post) {
  related = await relatedPosts(post.categoryIds, post.id, 3);
}

const categories: BlogCategory[] = await listBlogCategories();
const postCategories = post ? categories.filter((category) => post.categoryIds.includes(category.id)) : [];

const articleJsonLd = post
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: post.title,
      description: post.excerpt,
      image: post.hero?.url ?? ogImage.src,
      datePublished: post.firstPublishedDate?.toISOString(),
      mainEntityOfPage: pageUrl,
      author: { '@type': 'Organization', name: 'Petals & Predators' },
    }
  : null;
---

<Layout noindex={!post}>
  {
    seoTagsResolved ? (
      <SEO.Tags seoTagsServiceConfig={seoTagsServiceConfig} slot="seo-tags" />
    ) : null
  }
  <Fragment slot="head">
    {
      post ? (
        seoTagsResolved ? (
          <>
            <meta name="description" content={post.excerpt} />
            <meta property="og:description" content={post.excerpt} />
          </>
        ) : (
          <>
            <title>{`${post.title} — Petals & Predators`}</title>
            <meta name="description" content={post.excerpt} />
            <meta property="og:image" content={post.hero?.url ?? ogImage.src} />
            <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} is:inline />
          </>
        )
      ) : (
        <>
          <title>{t('blog.not-found.meta-title')}</title>
          <meta name="description" content={t('blog.not-found.meta-description')} />
        </>
      )
    }
  </Fragment>
  {
    post ? (
      <>
        <article class="relative z-2 bg-paper px-4 pt-24 pb-16 text-ink sm:px-8 lg:px-20 lg:pt-32">
          <div class="mx-auto max-w-3xl">
            <nav class="text-sm text-ink-soft" aria-label="Breadcrumb">
              <a href={localize('/')} class="transition-colors hover:text-accent">{t('nav.home')}</a>
              <span aria-hidden="true"> · </span>
              <a href={localize('/blog')} class="transition-colors hover:text-accent">{t('nav.blog')}</a>
              <span aria-hidden="true"> · </span>
              <span aria-current="page" class="text-ink">{post.title}</span>
            </nav>

            <h1 class="mt-8 font-display text-4xl leading-tight text-ink lg:text-5xl">{post.title}</h1>
            <p class="mt-4 flex flex-wrap items-center gap-3 text-sm text-ink-soft">
              {published && <span>{published}</span>}
              {published && post.minutesToRead != null && <span aria-hidden="true"> · </span>}
              {post.minutesToRead != null && (
                <span>{t(post.minutesToRead === 1 ? 'blog.min-read-one' : 'blog.min-read', { count: post.minutesToRead })}</span>
              )}
            </p>
            {postCategories.length > 0 && (
              <p class="mt-3 flex flex-wrap items-center gap-2">
                {postCategories.map((category) => (
                  <a
                    href={localize(`/blog/category/${category.slug}`)}
                    class="rounded-full border border-rule px-3 py-1 text-xs text-ink-soft transition-colors duration-500 ease-fluid hover:border-accent hover:text-accent"
                  >
                    {category.label}
                  </a>
                ))}
              </p>
            )}
          </div>

          {post.hero && (
            <div class="mx-auto mt-10 max-w-4xl overflow-hidden rounded-lg bg-paper-warm ring-1 ring-rule">
              <img
                src={post.hero.url}
                alt=""
                width={post.hero.width}
                height={post.hero.height}
                fetchpriority="high"
                decoding="async"
                class="aspect-video w-full object-cover"
              />
            </div>
          )}

          <div
            class="journal-body mx-auto mt-12 max-w-prose text-base leading-7 text-ink-soft"
            set:html={bodyHtml}
          />

          <div class="mx-auto mt-12 max-w-prose border-t border-rule pt-8">
            <p class="text-sm leading-6 text-ink-soft">
              {t('journal.article.cta-question')}
            </p>
            <a
              href={localize('/products')}
              class="mt-4 inline-flex h-11 items-center justify-center rounded-full bg-accent px-6 text-sm font-medium text-paper transition-colors duration-700 ease-fluid hover:bg-cream"
            >
              <span class="text-trim">{t('common.shop-the-collection')}</span>
            </a>
          </div>
        </article>

        {related.length > 0 && (
          <section class="relative z-2 bg-paper px-4 pb-24 sm:px-8 lg:px-20 lg:pb-32">
            <div class="mx-auto max-w-6xl">
              <div class="flex items-end justify-between gap-4">
                <div>
                  <p class="text-xs font-medium tracking-widest text-accent uppercase">{t('blog.related.eyebrow')}</p>
                  <h2 class="mt-3 font-display text-2xl text-ink lg:text-3xl">{t('blog.related.title')}</h2>
                </div>
                <a href={localize('/blog')} class="text-sm text-ink-soft transition-colors hover:text-accent">
                  {t('blog.all-posts')}
                </a>
              </div>
              <ul class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8">
                {related.map((item) => (
                  <li>
                    <a href={localize(`/blog/${item.slug}`)} class="group block">
                      <div class="relative aspect-video overflow-hidden rounded-md bg-paper-warm ring-1 ring-rule">
                        {item.hero && (
                          <img
                            src={item.hero.url}
                            alt=""
                            width={item.hero.width}
                            height={item.hero.height}
                            loading="lazy"
                            decoding="async"
                            class="h-full w-full object-cover transition-transform duration-500 ease-fluid group-hover:scale-105"
                          />
                        )}
                      </div>
                      <h3 class="mt-4 font-display text-xl leading-snug text-ink">{item.title}</h3>
                      <p class="mt-2 text-sm leading-6 text-ink-soft">{item.excerpt}</p>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </section>
        )}
      </>
    ) : (
      <section class="relative z-2 bg-paper px-4 pt-24 pb-24 text-ink sm:px-8 lg:px-20 lg:pt-32 lg:pb-32">
        <div class="mx-auto max-w-2xl">
          <p class="text-xs font-medium tracking-widest text-accent uppercase">{t('blog.not-found.eyebrow')}</p>
          <h1 class="mt-3 font-display text-4xl leading-tight text-ink lg:text-5xl">
            {t('blog.not-found.title')}
          </h1>
          <p class="mt-4 text-sm leading-6 text-ink-soft">
            {t('blog.not-found.body')}
          </p>
          <a
            href={localize('/blog')}
            class="mt-6 inline-flex h-11 items-center justify-center rounded-full bg-accent px-6 text-sm font-medium text-paper transition-colors duration-700 ease-fluid hover:bg-cream"
          >
            <span class="text-trim">{t('blog.not-found.cta')}</span>
          </a>
        </div>
      </section>
    )
  }
</Layout>
