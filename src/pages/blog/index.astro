---
import Layout from '@/app/layout.astro';
import { listBlogPosts, type BlogPost } from '@/features/blog/blog';
import { useTranslation, localize, currentLanguage } from '@/shared/i18n';

const { t } = useTranslation();

const posts = await listBlogPosts();
const featured = posts[0] ?? null;
const rest = posts.slice(1);

const formatDate = (date: Date | null): string =>
  date
    ? new Intl.DateTimeFormat(currentLanguage(), { month: 'short', day: 'numeric', year: 'numeric' }).format(date)
    : '';
---

<Layout>
  <section class="relative z-2 bg-paper px-4 pt-24 pb-12 text-ink sm:px-8 lg:px-20 lg:pt-32">
    <div class="mx-auto max-w-6xl">
      <nav class="text-sm text-ink-soft" aria-label="Breadcrumb">
        <a href={localize('/')} class="transition-colors hover:text-accent">{t('nav.home')}</a>
        <span aria-hidden="true"> · </span>
        <span aria-current="page" class="text-ink">{t('nav.blog')}</span>
      </nav>
      <p class="mt-6 text-xs font-medium tracking-widest text-accent uppercase">{t('blog.eyebrow')}</p>
      <h1 class="mt-3 font-display text-4xl leading-tight text-ink lg:text-5xl">{t('blog.title')}</h1>
      <p class="mt-4 max-w-xl text-sm leading-6 text-ink-soft">
        {t('blog.intro')}
      </p>
    </div>
  </section>

  <section class="relative z-2 bg-paper px-4 pb-24 sm:px-8 lg:px-20 lg:pb-32">
    <div class="mx-auto max-w-6xl">
      {
        posts.length === 0 ? (
          <p class="max-w-xl text-sm leading-6 text-ink-soft">
            {t('blog.empty')}{' '}
            <a href={localize('/journal')} class="text-accent underline">
              {t('blog.empty-cta')}
            </a>
            .
          </p>
        ) : (
          <>
            {featured && (
              <a
                href={localize(`/blog/${featured.slug}`)}
                class="group grid gap-6 rounded-lg border border-rule bg-paper-warm/40 p-6 transition-colors duration-500 ease-fluid hover:border-accent/40 sm:grid-cols-2 sm:items-center lg:gap-10 lg:p-8"
              >
                <div class="relative aspect-video overflow-hidden rounded-md bg-paper ring-1 ring-rule">
                  {featured.hero && (
                    <img
                      src={featured.hero.url}
                      alt=""
                      width={featured.hero.width}
                      height={featured.hero.height}
                      fetchpriority="high"
                      decoding="async"
                      class="h-full w-full object-cover transition-transform duration-500 ease-fluid group-hover:scale-105"
                    />
                  )}
                </div>
                <div>
                  <p class="text-xs font-medium tracking-widest text-accent uppercase">
                    {featured.categories[0] ?? t('blog.eyebrow')}
                  </p>
                  <h2 class="mt-3 font-display text-2xl leading-tight text-ink lg:text-3xl">
                    {featured.title}
                  </h2>
                  <p class="mt-3 text-sm leading-6 text-ink-soft">{featured.excerpt}</p>
                  <p class="mt-3 flex flex-wrap items-center gap-3 text-xs text-mute">
                    {featured.firstPublishedDate && <span>{formatDate(featured.firstPublishedDate)}</span>}
                    {featured.minutesToRead != null && (
                      <span>{t(featured.minutesToRead === 1 ? 'blog.min-read-one' : 'blog.min-read', { count: featured.minutesToRead })}</span>
                    )}
                  </p>
                  <span class="mt-5 inline-flex items-center gap-2 text-sm font-medium text-accent">
                    {t('blog.read-post')} <span aria-hidden="true">→</span>
                  </span>
                </div>
              </a>
            )}

            {rest.length > 0 && (
              <ul class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8">
                {rest.map((post) => (
                  <li>
                    <a href={localize(`/blog/${post.slug}`)} class="group block">
                      <div class="relative aspect-video overflow-hidden rounded-md bg-paper-warm ring-1 ring-rule">
                        {post.hero && (
                          <img
                            src={post.hero.url}
                            alt=""
                            width={post.hero.width}
                            height={post.hero.height}
                            loading="lazy"
                            decoding="async"
                            class="h-full w-full object-cover transition-transform duration-500 ease-fluid group-hover:scale-105"
                          />
                        )}
                      </div>
                      <p class="mt-4 text-xs font-medium tracking-widest text-accent uppercase">
                        {post.categories[0] ?? t('blog.eyebrow')}
                      </p>
                      <h3 class="mt-2 font-display text-xl leading-snug text-ink">{post.title}</h3>
                      <p class="mt-2 text-sm leading-6 text-ink-soft">{post.excerpt}</p>
                      <p class="mt-3 flex flex-wrap items-center gap-3">
                        {post.firstPublishedDate && <span class="text-xs text-mute">{formatDate(post.firstPublishedDate)}</span>}
                        {post.minutesToRead != null && (
                          <span class="text-xs text-mute">{t(post.minutesToRead === 1 ? 'blog.min-read-one' : 'blog.min-read', { count: post.minutesToRead })}</span>
                        )}
                      </p>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </>
        )
      }
    </div>
  </section>
</Layout>
