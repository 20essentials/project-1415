---
import Layout from '@/app/layout.astro';
import { getGuideBySlug, queryGuides, type CareGuide } from '@/features/journal';
import { renderRicos } from '@/shared/ricos';
import { useTranslation, localize, currentLanguage } from '@/shared/i18n';
import { ogImage } from '@/shared/og-image';

const { t } = useTranslation();

const slug = Astro.params.slug ?? '';
const guide = slug ? await getGuideBySlug(slug) : null;

if (!guide) {
  Astro.response.status = 404;
}

const forwardedUrl = Astro.request.headers.get('x-wix-forwarded-url');
const pageUrl =
  forwardedUrl && URL.canParse(forwardedUrl) && /^https?:$/.test(new URL(forwardedUrl).protocol)
    ? forwardedUrl
    : Astro.url.href;

const bodyHtml = guide ? renderRicos(guide.body) : '';

const published = guide?.createdDate
  ? new Intl.DateTimeFormat(currentLanguage(), { month: 'long', day: 'numeric', year: 'numeric' }).format(
      guide.createdDate,
    )
  : null;

let related: CareGuide[] = [];
if (guide) {
  const all = await queryGuides();
  related = all.filter((item) => item.slug !== guide.slug).slice(0, 3);
}

const articleJsonLd = guide
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: guide.title,
      description: guide.intro,
      image: guide.cover ?? ogImage.src,
      datePublished: guide.createdDate?.toISOString(),
      mainEntityOfPage: pageUrl,
      author: { '@type': 'Organization', name: 'Petals & Predators' },
    }
  : null;
---

<Layout noindex={!guide}>
  <Fragment slot="head">
    {
      guide ? (
        <>
          <title>{`${guide.title} — Petals & Predators`}</title>
          <meta name="description" content={guide.intro} />
          <meta property="og:image" content={guide.cover ?? ogImage.src} />
          <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} is:inline />
        </>
      ) : (
        <>
          <title>{t('journal.not-found.meta-title')}</title>
          <meta name="description" content={t('journal.not-found.meta-description')} />
        </>
      )
    }
  </Fragment>
  {
    guide ? (
      <>
        <article class="relative z-2 bg-paper px-4 pt-24 pb-16 text-ink sm:px-8 lg:px-20 lg:pt-32">
          <div class="mx-auto max-w-3xl">
            <nav class="text-sm text-ink-soft" aria-label="Breadcrumb">
              <a href={localize('/')} class="transition-colors hover:text-accent">{t('nav.home')}</a>
              <span aria-hidden="true"> · </span>
              <a href={localize('/journal')} class="transition-colors hover:text-accent">{t('nav.journal')}</a>
              <span aria-hidden="true"> · </span>
              <span aria-current="page" class="text-ink">{guide.title}</span>
            </nav>

            <p class="mt-6 text-xs font-medium tracking-widest text-accent uppercase">
              {guide.tag || t('journal.care-guide')}
            </p>
            <h1 class="mt-3 font-display text-4xl leading-tight text-ink lg:text-5xl">{guide.title}</h1>
            <p class="mt-4 max-w-2xl text-base leading-7 text-ink-soft">{guide.intro}</p>
            {published && <p class="mt-4 text-xs text-mute">{published}</p>}
          </div>

          {guide.cover && (
            <div class="mx-auto mt-10 max-w-4xl overflow-hidden rounded-lg bg-paper-warm ring-1 ring-rule">
              <img
                src={guide.cover}
                alt=""
                width="900"
                height="1125"
                fetchpriority="high"
                decoding="async"
                class="mx-auto aspect-4/5 max-h-128 w-auto object-cover"
              />
            </div>
          )}

          <div
            class="journal-body mx-auto mt-12 max-w-prose text-base leading-7 text-ink-soft"
            set:html={bodyHtml}
          />

          <div class="mx-auto mt-12 max-w-prose border-t border-rule pt-8">
            <p class="text-sm leading-6 text-ink-soft">
              {t('journal.article.cta-question')}
            </p>
            <a
              href={localize('/products')}
              class="mt-4 inline-flex h-11 items-center justify-center rounded-full bg-accent px-6 text-sm font-medium text-paper transition-colors duration-700 ease-fluid hover:bg-cream"
            >
              <span class="text-trim">{t('common.shop-the-collection')}</span>
            </a>
          </div>
        </article>

        {related.length > 0 && (
          <section class="relative z-2 bg-paper px-4 pb-24 sm:px-8 lg:px-20 lg:pb-32">
            <div class="mx-auto max-w-6xl">
              <div class="flex items-end justify-between gap-4">
                <div>
                  <p class="text-xs font-medium tracking-widest text-accent uppercase">{t('journal.related.eyebrow')}</p>
                  <h2 class="mt-3 font-display text-2xl text-ink lg:text-3xl">{t('journal.related.title')}</h2>
                </div>
                <a href={localize('/journal')} class="text-sm text-ink-soft transition-colors hover:text-accent">
                  {t('journal.all-guides')}
                </a>
              </div>
              <ul class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8">
                {related.map((item) => (
                  <li>
                    <a href={localize(`/journal/${item.slug}`)} class="group block">
                      <div class="relative aspect-4/5 overflow-hidden rounded-md bg-paper-warm ring-1 ring-rule">
                        {item.cover ? (
                          <img
                            src={item.cover}
                            alt=""
                            width="900"
                            height="1125"
                            loading="lazy"
                            decoding="async"
                            class="h-full w-full object-cover transition-transform duration-500 ease-fluid group-hover:scale-105"
                          />
                        ) : (
                          <span class="flex h-full w-full items-center justify-center text-xs text-mute">
                            {t('home.photo-coming')}
                          </span>
                        )}
                      </div>
                      <p class="mt-4 text-xs font-medium tracking-widest text-accent uppercase">
                        {item.tag || t('journal.care-guide')}
                      </p>
                      <h3 class="mt-2 font-display text-xl leading-snug text-ink">{item.title}</h3>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </section>
        )}
      </>
    ) : (
      <section class="relative z-2 bg-paper px-4 pt-24 pb-24 text-ink sm:px-8 lg:px-20 lg:pt-32 lg:pb-32">
        <div class="mx-auto max-w-2xl">
          <p class="text-xs font-medium tracking-widest text-accent uppercase">{t('journal.not-found.eyebrow')}</p>
          <h1 class="mt-3 font-display text-4xl leading-tight text-ink lg:text-5xl">
            {t('journal.not-found.title')}
          </h1>
          <p class="mt-4 text-sm leading-6 text-ink-soft">
            {t('journal.not-found.body')}
          </p>
          <a
            href={localize('/journal')}
            class="mt-6 inline-flex h-11 items-center justify-center rounded-full bg-accent px-6 text-sm font-medium text-paper transition-colors duration-700 ease-fluid hover:bg-cream"
          >
            <span class="text-trim">{t('journal.not-found.cta')}</span>
          </a>
        </div>
      </section>
    )
  }
</Layout>

<style is:global>
  .journal-body h1,
  .journal-body h2,
  .journal-body h3 {
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
    font-family: var(--font-display);
    font-size: 1.375rem;
    line-height: 1.3;
    color: var(--color-ink);
  }
  .journal-body p + p {
    margin-top: 0.75rem;
  }
  .journal-body ul {
    margin-top: 0.75rem;
    padding-left: 1.25rem;
    list-style: disc;
  }
  .journal-body ol {
    margin-top: 0.75rem;
    padding-left: 1.25rem;
    list-style: decimal;
  }
  .journal-body li {
    margin-top: 0.35rem;
  }
  .journal-body blockquote {
    margin-top: 1rem;
    padding-left: 1rem;
    border-left: 2px solid var(--color-accent);
    font-style: italic;
    color: var(--color-ink-soft);
  }
  .journal-body a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
