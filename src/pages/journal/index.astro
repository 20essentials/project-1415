---
import Layout from '@/app/layout.astro';
import { queryGuides } from '@/features/journal/journal';
import { useTranslation, localize, currentLanguage } from '@/shared/i18n';

const { t } = useTranslation();

const guides = await queryGuides();
const featured = guides[0] ?? null;
const rest = guides.slice(1);

const formatDate = (date: Date | null): string =>
  date
    ? new Intl.DateTimeFormat(currentLanguage(), { month: 'short', day: 'numeric', year: 'numeric' }).format(date)
    : '';
---

<Layout>
  <section class="relative z-2 bg-paper px-4 pt-24 pb-12 text-ink sm:px-8 lg:px-20 lg:pt-32">
    <div class="mx-auto max-w-6xl">
      <nav class="text-sm text-ink-soft" aria-label="Breadcrumb">
        <a href={localize('/')} class="transition-colors hover:text-accent">{t('nav.home')}</a>
        <span aria-hidden="true"> · </span>
        <span aria-current="page" class="text-ink">{t('nav.journal')}</span>
      </nav>
      <p class="mt-6 text-xs font-medium tracking-widest text-accent uppercase">{t('journal.eyebrow')}</p>
      <h1 class="mt-3 font-display text-4xl leading-tight text-ink lg:text-5xl">{t('journal.title')}</h1>
      <p class="mt-4 max-w-xl text-sm leading-6 text-ink-soft">
        {t('journal.intro')}
      </p>
    </div>
  </section>

  <section class="relative z-2 bg-paper px-4 pb-24 sm:px-8 lg:px-20 lg:pb-32">
    <div class="mx-auto max-w-6xl">
      {
        guides.length === 0 ? (
          <p class="max-w-xl text-sm leading-6 text-ink-soft">
            {t('journal.empty')}{' '}
            <a href={localize('/products')} class="text-accent underline">
              {t('journal.browse-plants')}
            </a>
            .
          </p>
        ) : (
          <>
            {featured && (
              <a
                href={localize(`/journal/${featured.slug}`)}
                class="group grid gap-6 rounded-lg border border-rule bg-paper-warm/40 p-6 transition-colors duration-500 ease-fluid hover:border-accent/40 sm:grid-cols-2 sm:items-center lg:gap-10 lg:p-8"
              >
                <div
                  class="relative aspect-4/5 overflow-hidden rounded-md bg-paper ring-1 ring-rule"
                  transition:name={featured.slug ? `journal-${featured.slug}` : undefined}
                >
                  {featured.cover ? (
                    <img
                      src={featured.cover}
                      alt=""
                      width="900"
                      height="1125"
                      fetchpriority="high"
                      decoding="async"
                      class="h-full w-full object-cover transition-transform duration-500 ease-fluid group-hover:scale-105"
                    />
                  ) : (
                    <span class="flex h-full w-full items-center justify-center text-xs text-mute">
                      {t('home.photo-coming')}
                    </span>
                  )}
                </div>
                <div>
                  <p class="text-xs font-medium tracking-widest text-accent uppercase">
                    {featured.tag || t('journal.care-guide')}
                  </p>
                  <h2 class="mt-3 font-display text-2xl leading-tight text-ink lg:text-3xl">
                    {featured.title}
                  </h2>
                  <p class="mt-3 text-sm leading-6 text-ink-soft">{featured.intro}</p>
                  <span class="mt-5 inline-flex items-center gap-2 text-sm font-medium text-accent">
                    {t('home.read-guide')} <span aria-hidden="true">→</span>
                  </span>
                </div>
              </a>
            )}

            {rest.length > 0 && (
              <ul class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8">
                {rest.map((guide) => (
                  <li>
                    <a href={localize(`/journal/${guide.slug}`)} class="group block">
                      <div
                        class="relative aspect-4/5 overflow-hidden rounded-md bg-paper-warm ring-1 ring-rule"
                        transition:name={guide.slug ? `journal-${guide.slug}` : undefined}
                      >
                        {guide.cover ? (
                          <img
                            src={guide.cover}
                            alt=""
                            width="900"
                            height="1125"
                            loading="lazy"
                            decoding="async"
                            class="h-full w-full object-cover transition-transform duration-500 ease-fluid group-hover:scale-105"
                          />
                        ) : (
                          <span class="flex h-full w-full items-center justify-center text-xs text-mute">
                            {t('home.photo-coming')}
                          </span>
                        )}
                      </div>
                      <p class="mt-4 text-xs font-medium tracking-widest text-accent uppercase">
                        {guide.tag || t('journal.care-guide')}
                      </p>
                      <h3 class="mt-2 font-display text-xl leading-snug text-ink">{guide.title}</h3>
                      <p class="mt-2 text-sm leading-6 text-ink-soft">{guide.intro}</p>
                      <p class="mt-3 flex flex-wrap items-center gap-3">
                        {guide.createdDate && <span class="text-xs text-mute">{formatDate(guide.createdDate)}</span>}
                        {guide.premium && (
                          <span class="rounded-full border border-accent px-3 py-0.5 text-xs font-medium tracking-widest text-accent uppercase">
                            {t('journal.premium.badge')}
                          </span>
                        )}
                      </p>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </>
        )
      }
    </div>
  </section>
</Layout>
