---
import Layout from '@/app/layout.astro';
import { SITE_TIMEZONE, getWorkshopBookingState, type WorkshopBookingState } from '@/features/workshops/bookings';
import { currentLanguage, localize, useTranslation } from '@/shared/i18n';

const { t } = useTranslation();

const id = Astro.url.searchParams.get('id') || Astro.url.searchParams.get('bookingId') || Astro.url.searchParams.get('bookingNumber');
const service = Astro.url.searchParams.get('service');
const start = Astro.url.searchParams.get('start') || Astro.url.searchParams.get('startDate');
const end = Astro.url.searchParams.get('end') || Astro.url.searchParams.get('endDate');

let resolved: WorkshopBookingState | null = null;
if (id) {
  resolved = await getWorkshopBookingState(id);
}

const statusParam = Astro.url.searchParams.get('status');
const status = resolved?.status ?? (statusParam ? statusParam.toUpperCase() : null);
const paymentStatus = resolved?.paymentStatus ?? null;

const hasBooking = Boolean(id && service && start && end);

const confirmed = status === 'CONFIRMED' || paymentStatus === 'PAID';
const pending = status === 'PENDING' || status === 'CREATED';
const paymentLine = confirmed
  ? t('booking-confirmation.payment.confirmed')
  : pending
    ? t('booking-confirmation.payment.pending')
    : t('booking-confirmation.payment.status');

const sessionDay = hasBooking && start
  ? new Intl.DateTimeFormat(currentLanguage(), {
      timeZone: SITE_TIMEZONE,
      weekday: 'long',
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    }).format(new Date(`${String(start).slice(0, 10)}T12:00:00Z`))
  : null;
const sessionRange = hasBooking && start && end ? `${String(start).slice(11, 16)}–${String(end).slice(11, 16)}` : null;
---

<Layout noindex>
  <section class="relative z-2 bg-paper px-4 py-24 text-ink sm:px-8 lg:px-20 lg:py-32">
    <div class="mx-auto max-w-xl">
      {
        hasBooking ? (
          <>
            <p class="text-xs font-medium tracking-widest text-accent uppercase">{t('nav.services')}</p>
            <h1 class="mt-3 font-display text-4xl leading-tight text-ink lg:text-5xl">
              {t('booking-confirmation.title')}
            </h1>
            <p class="mt-4 text-sm leading-6 text-ink-soft">{t('booking-confirmation.body')}</p>
            <p class="mt-2 text-sm leading-6 text-ink-soft">{paymentLine}</p>

            <dl class="mt-8 flex flex-col gap-4 rounded-md border border-rule bg-paper-warm p-5">
              <div class="flex flex-col gap-1">
                <dt class="text-xs font-medium tracking-widest text-mute uppercase">
                  {t('booking-confirmation.reference')}
                </dt>
                <dd class="text-sm text-ink break-all">{id}</dd>
              </div>
              <div class="flex flex-col gap-1">
                <dt class="text-xs font-medium tracking-widest text-mute uppercase">
                  {t('booking-confirmation.session')}
                </dt>
                <dd class="text-sm text-ink">
                  {service} — {sessionDay}, {sessionRange} · {t('services.timezone-note')}
                </dd>
              </div>
            </dl>

            <a
              href={localize('/services')}
              class="mt-8 inline-flex h-11 items-center justify-center rounded-full bg-accent px-6 text-sm font-medium text-paper transition-colors duration-700 ease-fluid hover:bg-cream focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
            >
              {t('booking-confirmation.back')}
            </a>
          </>
        ) : (
          <>
            <p class="text-xs font-medium tracking-widest text-accent uppercase">{t('nav.services')}</p>
            <h1 class="mt-3 font-display text-4xl leading-tight text-ink lg:text-5xl">
              {t('booking-confirmation.missing-title')}
            </h1>
            <p class="mt-4 text-sm leading-6 text-ink-soft">{t('booking-confirmation.missing-body')}</p>
            <a
              href={localize('/services')}
              class="mt-8 inline-flex h-11 items-center justify-center rounded-full bg-accent px-6 text-sm font-medium text-paper transition-colors duration-700 ease-fluid hover:bg-cream focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
            >
              {t('booking-confirmation.back')}
            </a>
          </>
        )
      }
    </div>
  </section>
  {hasBooking && confirmed && (
    <script is:inline define:vars={{ id, service }}>
      (function () {
        try {
          if (typeof window === 'undefined') return;
          window.addEventListener('load', function () {
            try {
              import('/src/shared/analytics.ts').then(function (mod) {
                if (mod && typeof mod.trackEvent === 'function') {
                  mod.trackEvent('Schedule', {
                    id: id || undefined,
                    service: service || undefined,
                  });
                }
              }).catch(function () {});
            } catch (e) {}
          }, { once: true });
        } catch (e) {}
      })();
    </script>
  )}
</Layout>

