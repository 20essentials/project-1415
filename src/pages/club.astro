---
import Layout from '@/app/layout.astro';
import { PlanCheckout } from '@/features/club/plan-checkout';
import { listClubPlans } from '@/features/club/plans';
import { getMemberMembership, type ClubMembership } from '@/features/club/membership';
import { members } from '@wix/members';
import { localize, currentLanguage, useTranslation } from '@/shared/i18n';

const { t } = useTranslation();
const locale = currentLanguage();

let member: { _id: string } | null = null;
try {
  const res = await members.getCurrentMember();
  if (res.member?._id) member = { _id: res.member._id };
} catch {
  member = null;
}

const membership: ClubMembership | null = member ? await getMemberMembership(member._id) : null;

const plans = membership?.active ? [] : await listClubPlans(locale);

const checkoutLabels = {
  submit: t('club.plan.submit'),
  submitting: t('club.plan.submitting'),
  error: t('club.plan.error'),
  retry: t('services.retry'),
  loginInvite: t('club.plan.login-invite'),
  loginLink: t('club.plan.login-link'),
  billedMonthly: t('club.plan.billed-monthly'),
  billedYearly: t('club.plan.billed-yearly'),
  billedOnce: t('club.plan.billed-once'),
};

const formatDate = membership?.endDate
  ? new Intl.DateTimeFormat(locale, { day: 'numeric', month: 'long', year: 'numeric' }).format(
      membership.endDate,
    )
  : null;

const cancelled = Astro.url.searchParams.has('checkout');

const perksList = [
  { title: 'club.perk.1.title', body: 'club.perk.1.body' },
  { title: 'club.perk.2.title', body: 'club.perk.2.body' },
  { title: 'club.perk.3.title', body: 'club.perk.3.body' },
];
---

<Layout>
  <Fragment slot="head">
    <title>{t('club.meta-title')}</title>
    <meta name="description" content={t('club.meta-description')} />
  </Fragment>

  <section class="relative z-2 bg-paper px-4 pt-24 pb-12 text-ink sm:px-8 lg:px-20 lg:pt-32">
    <div class="mx-auto max-w-6xl">
      <nav class="text-sm text-ink-soft" aria-label="Breadcrumb">
        <a href={localize('/')} class="transition-colors hover:text-accent">{t('nav.home')}</a>
        <span aria-hidden="true"> · </span>
        <span aria-current="page" class="text-ink">{t('club.title')}</span>
      </nav>
      <p class="mt-6 text-xs font-medium tracking-widest text-accent uppercase">{t('club.eyebrow')}</p>
      <h1 class="mt-3 font-display text-4xl leading-tight text-ink lg:text-5xl">{t('club.title')}</h1>
      <p class="mt-4 max-w-xl text-base leading-7 text-ink-soft">{t('club.intro')}</p>
    </div>
  </section>

  <section class="relative z-2 bg-paper px-4 pb-24 sm:px-8 lg:px-20 lg:pb-32">
    <div class="mx-auto max-w-6xl">
      {
        cancelled && (
          <p role="status" class="mb-8 rounded-md border border-rule bg-paper-warm/60 px-4 py-3 text-sm text-ink">
            {t('club.checkout-cancelled')}
          </p>
        )
      }

      {
        membership?.active ? (
          <article class="rounded-md border border-accent/40 bg-paper-warm/40 p-6 sm:p-8">
            <p class="text-xs font-medium tracking-widest text-accent uppercase">{t('account.club.title')}</p>
            <h2 class="mt-3 font-display text-2xl text-ink lg:text-3xl">{t('club.member.title')}</h2>
            <p class="mt-3 text-sm leading-6 text-ink-soft">
              {t('club.member.body', { plan: membership.planName || t('club.title') })}
            </p>
            {formatDate && (
              <p class="mt-2 text-sm text-ink">
                {membership.active ? t('club.member.ends') : t('club.member.pending')}{' '}
                <span class="font-medium">{formatDate}</span>
              </p>
            )}
            <a
              href={localize('/journal')}
              class="mt-5 inline-flex h-11 items-center justify-center rounded-full bg-accent px-6 text-sm font-medium text-paper transition-colors duration-700 ease-fluid hover:bg-cream"
            >
              <span class="text-trim">{t('club.member.read-guides')}</span>
            </a>
          </article>
        ) : plans.length > 0 ? (
          <PlanCheckout client:load plans={plans} labels={checkoutLabels} loginUrl={localize('/api/auth/login?returnToUrl=/club')} />
        ) : (
          <p class="max-w-xl text-sm leading-6 text-ink-soft">{t('club.empty')}</p>
        )
      }

      <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8">
        {
          perksList.map((perk) => (
            <div class="rounded-md border border-rule bg-paper-warm/40 p-6">
              <h2 class="font-display text-lg text-ink">{t(perk.title)}</h2>
              <p class="mt-2 text-sm leading-6 text-ink-soft">{t(perk.body)}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
