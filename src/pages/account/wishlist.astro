---
import Layout from '@/app/layout.astro';
import { members } from '@wix/members';
import { localize, useTranslation } from '@/shared/i18n';
import { listWishlistProducts } from '@/features/wishlist/wishlist';
import ProductCard from '@/features/product-catalog/product-card.astro';
import type { Member } from '@wix/auto_sdk_members_members';

const { t } = useTranslation();

let member: Member | null = null;
try {
  const res = await members.getCurrentMember({ fieldsets: ['FULL'] });
  member = res.member ?? null;
} catch {
  member = null;
}

if (!member) {
  return Astro.redirect(localize(`/api/auth/login?returnToUrl=${localize('/account/wishlist')}`));
}

const memberId = member._id ?? '';
const products = memberId ? await listWishlistProducts(memberId) : [];
---

<Layout noindex>
  <section class="relative z-2 bg-paper px-4 pt-24 pb-24 text-ink sm:px-8 lg:px-20 lg:pt-32 lg:pb-32">
    <div class="mx-auto max-w-6xl">
      <nav class="text-sm text-ink-soft" aria-label="Breadcrumb">
        <a href={localize('/')} class="transition-colors hover:text-accent">{t('nav.home')}</a>
        <span aria-hidden="true"> · </span>
        <a href={localize('/account')} class="transition-colors hover:text-accent">{t('account.eyebrow')}</a>
        <span aria-hidden="true"> · </span>
        <span aria-current="page" class="text-ink">{t('wishlist.title')}</span>
      </nav>

      <p class="mt-6 text-xs font-medium tracking-widest text-accent uppercase">{t('account.eyebrow')}</p>
      <h1 class="mt-3 font-display text-4xl leading-tight text-ink lg:text-5xl">{t('wishlist.title')}</h1>

      {
        products.length > 0 ? (
          <ul class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3 xl:grid-cols-4">
            {products.map((product, index) => (
              <ProductCard product={product} index={index} isMember wished sizes="(min-width: 1280px) 280px, (min-width: 1024px) 33vw, (min-width: 640px) 46vw, 92vw" />
            ))}
          </ul>
        ) : (
          <p class="mt-10 max-w-xl text-base text-ink-soft">
            {t('wishlist.empty')}{' '}
            <a href={localize('/products')} class="text-accent underline">{t('wishlist.empty-cta')}</a>.
          </p>
        )
      }

      <p class="mt-8">
        <a href={localize('/account')} class="text-sm text-ink-soft transition-colors hover:text-accent">
          {t('wishlist.back-to-account')}
        </a>
      </p>
    </div>
  </section>
</Layout>
