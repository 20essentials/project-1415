---
import Layout from '@/layouts/layout.astro';
---
<Layout>
  <section class="relative">
    <div class="max-w-6xl mx-auto px-6 py-24 grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
      <div class="flex flex-col gap-6">
        <h1 class="font-display text-4xl md:text-5xl lg:text-[50px] lg:leading-13 tracking-[-2px]">Petals with teeth.</h1>
        <p class="text-lg text-mute max-w-prose">Carnivorous specimens, show-stopping blooms, and care-tested kits — greenhouse-grown and shipped alive to your door.</p>
        <div class="flex gap-4 mt-2">
          <a href="/products" class="px-5 py-3 rounded-sm bg-accent text-paper font-medium">Shop plants</a>
        </div>
      </div>
      <div
        class="hero-image rounded-md aspect-4/5 bg-paper-warm"
        data-decorative-slot="hero"
      >
        <!-- orchestrator injects <img src={decorativeImages.hero} …> here -->
      </div>
    </div>
  </section>  <!-- home:stores -->
  <!-- home:gift-cards -->
  <section class="max-w-6xl mx-auto px-6 py-24 grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
    <div
      class="about-image rounded-md aspect-4/3 bg-paper-warm order-last md:order-first"
      data-decorative-slot="about"
    >
      <!-- orchestrator injects <img src={decorativeImages.about} …> here -->
    </div>
    <div class="flex flex-col gap-4 max-w-prose">
      <hr class="h-px w-16 border-0 bg-accent opacity-60" />
      <h2 class="font-display text-3xl leading-tight">The story behind Petals & Predators</h2>
      <p class="text-ink leading-relaxed">
        A short, brand-contextual paragraph about what makes Petals & Predators distinct.
      </p>
      <p class="text-mute leading-relaxed">
        A second paragraph adding warmth and detail to the brand story.
      </p>
    </div>
  </section>
</Layout>
