---
import Layout from '@/app/layout.astro';
import ScrollWorld from '@/features/home/scroll-world.astro';
import { ShinyText } from '@/shared/motion/shiny-text';
import { Reveal } from '@/shared/motion/reveal';
import { CountUp } from '@/shared/motion/count-up';
import { SpotlightCard } from '@/shared/motion/spotlight-card';
import { CardHover } from '@/features/product-catalog/card-hover';
import '@/features/product-catalog/card-hover.css';
import { productsV3 } from '@wix/stores';
import { listStoreCategories } from '@/features/product-catalog/categories';
import ProductCard from '@/features/product-catalog/product-card.astro';
import RatingStars from '@/features/reviews/rating-stars.astro';
import { site } from '@/shared/site';
import { queryGuides } from '@/features/journal/journal';
import { getFeaturedReviews } from '@/features/reviews/reviews';
import { getDonationCampaign } from '@/features/donations/donations';
import { listBlogPosts } from '@/features/blog/blog';
import { getJungleExperience, projectOccurrences } from '@/features/dining/reservations';
import { useTranslation, localize, currentLanguage } from '@/shared/i18n';
import AnalyticsView from '@/shared/analytics-view.astro';

const { t } = useTranslation();

const claims = [
  {
    title: 'home.eco.greenhouse.title',
    body: 'home.eco.greenhouse.body',
    paths: [
      'M7 20h10',
      'M10 20c5.5-2.5.8-6.4 3-10',
      'M9.5 9.4c1.1.8 1.8 2.2 2.3 3.7-2 .4-3.5.4-4.8-.3-1.2-.6-2.3-1.9-3-4.2 2.8-.5 4.4 0 5.5.8z',
      'M14.1 6a7 7 0 0 0-1.1 4c1.9-.1 3.3-.6 4.3-1.4 1-1 1.6-2.3 1.7-4.6-2.7.1-4 1-4.9 2z',
    ],
  },
  {
    title: 'home.eco.shipped.title',
    body: 'home.eco.shipped.body',
    paths: [
      'M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2',
      'M15 18H9',
      'M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17 8h-3',
      'M15 18a2 2 0 1 0 4 0 2 2 0 1 0-4 0',
      'M5 18a2 2 0 1 0 4 0 2 2 0 1 0-4 0',
    ],
  },
  {
    title: 'home.eco.care.title',
    body: 'home.eco.care.body',
    paths: ['M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20'],
  },
];

const categories = await listStoreCategories();

const guides = await queryGuides();
const featuredGuide = guides[0] ?? null;

const featuredReviews = await getFeaturedReviews();

const donationsCampaign = await getDonationCampaign();

const diningExperience = await getJungleExperience();
const diningOccurrences = diningExperience ? projectOccurrences(diningExperience, 1) : [];
const diningNextDate = diningOccurrences.length > 0
  ? new Intl.DateTimeFormat(currentLanguage(), {
      timeZone: 'Europe/Rome',
      weekday: 'long',
      day: 'numeric',
      month: 'long',
    }).format(new Date(`${diningOccurrences[0].slice(0, 10)}T12:00:00Z`))
  : null;

const blogTeaser = await listBlogPosts(3, currentLanguage());
const formatTeaserDate = (date: Date | null): string =>
  date
    ? new Intl.DateTimeFormat(currentLanguage(), { month: 'short', day: 'numeric', year: 'numeric' }).format(date)
    : '';

let products: {
  _id?: string | null;
  name?: string | null;
  slug?: string | null;
  ribbon?: { name?: string | null } | null;
}[] = [];

try {
  const result = await productsV3.queryProducts({ fields: ['CURRENCY'] }).limit(6).find();
  products = result.items ?? [];
} catch (error) {
  console.error('[home] featured products query failed:', error);
}
---

<Layout>
  <AnalyticsView event="CustomEvent" payload={{ eventCategory: 'Page', eventAction: 'ViewHome' }} />
  <link slot="head" rel="preload" as="image" href={site.paseo.stops[0].poster} fetchpriority="high" />
  <ScrollWorld />

  <section class="relative z-2 bg-paper px-4 py-20 text-ink sm:px-8 lg:px-20 lg:py-28">
    <ul class="mx-auto grid max-w-6xl gap-10 sm:grid-cols-3">
      {
        claims.map((claim, index) => (
          <li>
            <Reveal delay={index * 90} className="flex items-start gap-4">
              <span class="flex size-11 shrink-0 items-center justify-center rounded-full bg-accent/10 text-accent">
                <svg
                  width="22"
                  height="22"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  {claim.paths.map((d) => <path d={d} />)}
                </svg>
              </span>
              <div>
                <p class="font-display text-lg text-ink">{t(claim.title)}</p>
                <p class="mt-1 text-sm leading-6 text-ink-soft">{t(claim.body)}</p>
              </div>
            </Reveal>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- home:stores -->

  <section class="relative z-2 bg-paper px-4 pb-20 text-ink sm:px-8 lg:px-20 lg:pb-28">
    <div class="mx-auto max-w-6xl">
      <CardHover client:idle />
      <header class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="text-xs font-medium tracking-widest text-accent uppercase">
            <ShinyText client:visible>{t('home.featured')}</ShinyText>
          </p>
          <h2 class="mt-3 font-display text-3xl leading-tight text-ink lg:text-4xl">
            {t('home.fresh')}
          </h2>
        </div>
        <a
          href={localize('/products')}
          class="inline-flex h-10 items-center justify-center rounded-full px-5 text-sm font-medium text-ink ring-1 ring-rule transition-colors duration-700 ease-fluid hover:bg-ink/10"
        >
          <span class="text-trim">{t('home.see-all')}</span>
        </a>
      </header>

      {
        products.length > 0 ? (
          <ul class="mt-12 grid grid-cols-2 gap-4 sm:gap-6 lg:grid-cols-3">
            {products.map((product, index) => (
              <ProductCard product={product} index={index} sizes="(min-width: 1024px) 33vw, 46vw" />
            ))}
          </ul>
        ) : (
          <p class="mt-12 max-w-xl text-sm leading-6 text-ink-soft">
            {t('home.empty')}{' '}
            <a href={localize('/products')} class="text-accent underline">{t('home.see-shop')}</a>.
          </p>
        )
      }
    </div>
  </section>

  <section class="relative z-2 bg-paper px-4 pb-24 text-ink sm:px-8 lg:px-20 lg:pb-32">
    <div class="mx-auto max-w-6xl">
      <p class="text-xs font-medium tracking-widest text-accent uppercase">{t('home.collection')}</p>
      <h2 class="mt-3 font-display text-3xl sm:text-4xl">{t('home.shop-by-category')}</h2>

      {
        categories.length > 0 ? (
          <div class="mt-12 grid gap-6 sm:grid-cols-2">
            {categories.map((category) => (
              <a
                href={localize(`/category/${category.slug}`)}
                class="group flex items-center justify-between gap-6 rounded-lg border border-rule bg-paper-warm p-8 transition-colors duration-700 ease-fluid hover:border-accent/40"
              >
                <span>
                  <span class="block font-display text-2xl text-ink">{category.name}</span>
                  <span class="mt-1 block text-sm text-ink-soft">
                    <CountUp client:visible to={category.itemCounter} className="font-medium" />{' '}
                    {t(category.itemCounter === 1 ? 'home.plants-count-one' : 'home.plants-count-other')}
                  </span>
                </span>
                <span class="text-sm font-medium text-accent">{t('home.explore')}</span>
              </a>
            ))}
          </div>
        ) : (
          <p class="mt-12 max-w-xl text-sm leading-6 text-ink-soft">
            {t('home.categories-empty')}{' '}
            <a href={localize('/products')} class="text-accent underline">{t('home.browse-all')}</a>.
          </p>
        )
      }
    </div>
  </section>

  <section class="relative z-2 bg-paper-warm px-4 py-24 text-ink sm:px-8 lg:px-20">
    <div class="mx-auto max-w-3xl">
      <p class="text-xs font-medium tracking-widest text-accent uppercase">{t('home.faq')}</p>
      <h2 class="mt-3 font-display text-3xl sm:text-4xl">{t('home.good-to-know')}</h2>
      <div class="mt-10 flex flex-col gap-2">
        {
          site.faqs.map((faq) => (
            <details class="faq rounded-lg border border-rule bg-paper px-6">
              <summary class="flex cursor-pointer items-center justify-between gap-4 py-5 font-display text-lg text-ink">
                {t(faq.q)}
                <span class="faq-icon text-xl text-accent" aria-hidden="true">
                  +
                </span>
              </summary>
              <p class="pb-6 text-sm leading-6 text-ink-soft">{t(faq.a)}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  {
    featuredGuide && (
      <section class="relative z-2 bg-paper px-4 pb-24 text-ink sm:px-8 lg:px-20 lg:pb-32">
        <div class="mx-auto max-w-6xl">
          <a
            href={localize(`/journal/${featuredGuide.slug}`)}
            class="group grid overflow-hidden rounded-lg border border-rule bg-paper-warm/40 transition-colors duration-700 ease-fluid hover:border-accent/40 lg:grid-cols-2"
          >
            <div class="relative aspect-4/5 overflow-hidden bg-paper-warm lg:aspect-auto lg:min-h-96">
              {featuredGuide.cover ? (
                <img
                  src={featuredGuide.cover}
                  alt=""
                  width="900"
                  height="1125"
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover transition-transform duration-700 ease-fluid group-hover:scale-105"
                />
              ) : (
                <span class="flex h-full w-full items-center justify-center text-xs text-mute">
                  {t('home.photo-coming')}
                </span>
              )}
            </div>
            <div class="flex flex-col justify-center p-8 lg:p-12">
              <p class="text-xs font-medium tracking-widest text-accent uppercase">{t('home.journal')}</p>
              <h2 class="mt-3 font-display text-3xl leading-tight text-ink lg:text-4xl">
                {featuredGuide.title}
              </h2>
              <p class="mt-4 max-w-md text-sm leading-6 text-ink-soft">{featuredGuide.intro}</p>
              <span class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-accent">
                {t('home.read-guide')} <span aria-hidden="true">→</span>
              </span>
            </div>
          </a>
          <div class="mt-6">
            <a href={localize('/journal')} class="text-sm text-ink-soft transition-colors hover:text-accent">
              {t('home.all-guides')} →
            </a>
          </div>
        </div>
      </section>
    )
  }

  <section class="relative z-2 bg-paper px-4 pb-24 text-ink sm:px-8 lg:px-20 lg:pb-32">
    <div class="mx-auto max-w-6xl">
      <a
        href={localize('/lookbook')}
        class="group flex flex-col items-start justify-between gap-6 rounded-lg border border-rule bg-paper-warm p-8 transition-colors duration-700 ease-fluid hover:border-accent/40 sm:flex-row sm:items-center lg:p-12"
      >
        <div>
          <p class="text-xs font-medium tracking-widest text-accent uppercase">{t('lookbook.eyebrow')}</p>
          <p class="mt-3 font-display text-3xl leading-tight text-ink lg:text-4xl">{t('lookbook.title')}</p>
          <p class="mt-3 max-w-md text-sm leading-6 text-ink-soft">{t('lookbook.intro')}</p>
        </div>
        <span class="inline-flex h-11 shrink-0 items-center justify-center rounded-full bg-accent px-6 text-sm font-medium text-paper transition-colors duration-700 ease-fluid group-hover:bg-cream">
          <span class="text-trim">{t('home.lookbookCta')}</span>
        </span>
      </a>
    </div>
  </section>

  {
    featuredReviews.length > 0 && (
      <section class="relative z-2 bg-paper px-4 pb-24 text-ink sm:px-8 lg:px-20 lg:pb-32">
        <div class="mx-auto max-w-6xl">
          <h2 class="font-display text-3xl leading-tight sm:text-4xl">{t('reviews.sectionTitle')}</h2>
          <ul class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
            {featuredReviews.map((review) => (
              <li>
                <SpotlightCard
                  client:visible
                  className="flex h-full flex-col gap-4 rounded-md border border-rule bg-paper-warm p-6"
                >
                  <RatingStars rating={review.content.rating} size="sm" />
                  <blockquote class="font-display text-base leading-6 text-ink">
                    {review.content.body}
                  </blockquote>
                  <footer class="mt-auto text-xs font-medium text-ink-soft">
                    {review.author.authorName ?? ''}
                  </footer>
                </SpotlightCard>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- home:gift-cards -->

  <!-- home:donations -->
  {
    donationsCampaign && (
      <section class="relative z-2 bg-paper px-4 pb-24 text-ink sm:px-8 lg:px-20 lg:pb-32">
        <div class="mx-auto max-w-6xl">
          <a
            href={localize('/donate')}
            class="group flex flex-col items-start justify-between gap-6 rounded-lg border border-rule bg-paper-warm p-8 transition-colors duration-700 ease-fluid hover:border-accent/40 sm:flex-row sm:items-center lg:p-12"
          >
            <div>
              <p class="text-xs font-medium tracking-widest text-accent uppercase">{t('donations.eyebrow')}</p>
              <p class="mt-3 font-display text-3xl leading-tight text-ink lg:text-4xl">{t('home.donations.title')}</p>
              <p class="mt-3 max-w-md text-sm leading-6 text-ink-soft">{t('home.donations.body')}</p>
            </div>
            <span class="inline-flex h-11 shrink-0 items-center justify-center rounded-full bg-accent px-6 text-sm font-medium text-paper transition-colors duration-700 ease-fluid group-hover:bg-cream">
              <span class="text-trim">{t('home.donations.cta')}</span>
            </span>
          </a>
        </div>
      </section>
    )
  }

  <section class="relative z-2 bg-paper px-4 pb-24 text-ink sm:px-8 lg:px-20 lg:pb-32">
    <div class="mx-auto max-w-6xl">
      <a
        href={localize('/dining')}
        class="group flex flex-col items-start justify-between gap-6 rounded-lg border border-rule bg-paper-warm p-8 transition-colors duration-700 ease-fluid hover:border-accent/40 sm:flex-row sm:items-center lg:p-12"
      >
        <div>
          <p class="text-xs font-medium tracking-widest text-accent uppercase">{t('home.dining.eyebrow')}</p>
          <p class="mt-3 font-display text-3xl leading-tight text-ink lg:text-4xl">{t('home.dining.title')}</p>
          <p class="mt-3 max-w-md text-sm leading-6 text-ink-soft">
            {t('home.dining.body')}
            {diningNextDate && <span class="mt-1 block font-medium text-ink capitalize">{diningNextDate}</span>}
          </p>
        </div>
        <span class="inline-flex h-11 shrink-0 items-center justify-center rounded-full bg-accent px-6 text-sm font-medium text-paper transition-colors duration-700 ease-fluid group-hover:bg-cream">
          <span class="text-trim">{t('home.dining.cta')}</span>
        </span>
      </a>
    </div>
  </section>

  {
    blogTeaser.length > 0 && (
      <section class="relative z-2 bg-paper px-4 pb-24 text-ink sm:px-8 lg:px-20 lg:pb-32">
        <div class="mx-auto max-w-6xl">
          <div class="flex items-end justify-between gap-6">
            <p class="text-xs font-medium tracking-widest text-accent uppercase">{t('home.from-blog')}</p>
            <a href={localize('/blog')} class="text-sm text-ink-soft transition-colors hover:text-accent">
              {t('blog.all-posts')} →
            </a>
          </div>
          <ul class="mt-8 grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-3">
            {blogTeaser.map((post) => (
              <li>
                <a href={localize(`/blog/${post.slug}`)} class="group block">
                  <div class="relative aspect-video overflow-hidden rounded-md bg-paper-warm ring-1 ring-rule">
                    {post.hero && (
                      <img
                        src={post.hero.url}
                        alt=""
                        width={post.hero.width}
                        height={post.hero.height}
                        loading="lazy"
                        decoding="async"
                        class="h-full w-full object-cover transition-transform duration-500 ease-fluid group-hover:scale-105"
                      />
                    )}
                  </div>
                  <p class="mt-4 text-xs font-medium tracking-widest text-accent uppercase">
                    {post.categories[0] ?? t('home.from-blog')}
                  </p>
                  <h3 class="mt-2 font-display text-xl leading-snug text-ink">{post.title}</h3>
                  <p class="mt-3 flex flex-wrap items-center gap-3">
                    {post.firstPublishedDate && (
                      <span class="text-xs text-mute">{formatTeaserDate(post.firstPublishedDate)}</span>
                    )}
                    {post.minutesToRead != null && (
                      <span class="text-xs text-mute">
                        {t(post.minutesToRead === 1 ? 'blog.min-read-one' : 'blog.min-read', { count: post.minutesToRead })}
                      </span>
                    )}
                  </p>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="relative z-2 bg-paper px-4 pb-24 text-ink sm:px-8 lg:px-20 lg:pb-32">
    <div class="mx-auto max-w-6xl">
      <a
        href={localize('/gift-cards')}
        class="group flex flex-col items-start justify-between gap-6 rounded-lg border border-rule bg-paper-warm p-8 transition-colors duration-700 ease-fluid hover:border-accent/40 sm:flex-row sm:items-center lg:p-12"
      >
        <div>
          <p class="text-xs font-medium tracking-widest text-accent uppercase">{t('gift-cards.teaser.eyebrow')}</p>
          <p class="mt-3 font-display text-3xl leading-tight text-ink lg:text-4xl">{t('gift-cards.teaser.title')}</p>
          <p class="mt-3 max-w-md text-sm leading-6 text-ink-soft">{t('gift-cards.teaser.body')}</p>
        </div>
        <span class="inline-flex h-11 shrink-0 items-center justify-center rounded-full bg-accent px-6 text-sm font-medium text-paper transition-colors duration-700 ease-fluid group-hover:bg-cream">
          <span class="text-trim">{t('gift-cards.teaser.cta')}</span>
        </span>
      </a>
    </div>
  </section>
</Layout>
