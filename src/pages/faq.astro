---
import Layout from '@/app/layout.astro';
import { FaqAccordion, type FaqAccordionLabels } from '@/features/faq/faq-accordion';
import { getFaqPage } from '@/features/faq/faq';
import { localize, useTranslation } from '@/shared/i18n';

const { t } = useTranslation();

const { categories, questions } = await getFaqPage();

const labels: FaqAccordionLabels = {
  searchLabel: t('faq.search.label'),
  searchPlaceholder: t('faq.search.placeholder'),
  searchClear: t('faq.search.clear'),
  noResults: t('faq.search.no-results'),
  emptyTitle: t('faq.empty.title'),
  emptyBody: t('faq.empty.body'),
  resultsOne: t('faq.count.one'),
  resultsMany: t('faq.count.many'),
  copyLink: t('faq.copy-link'),
  copied: t('faq.copied'),
};
---

<Layout>
  <Fragment slot="head">
    <meta name="description" content={t('faq.meta-description')} />
  </Fragment>

  <section class="relative z-2 bg-paper px-4 pt-24 pb-10 text-ink sm:px-8 lg:px-20 lg:pt-32">
    <div class="mx-auto max-w-6xl">
      <nav class="text-sm text-ink-soft" aria-label="Breadcrumb">
        <a href={localize('/')} class="transition-colors hover:text-accent">{t('nav.home')}</a>
        <span aria-hidden="true"> · </span>
        <span aria-current="page" class="text-ink">{t('nav.faq')}</span>
      </nav>
      <p class="mt-6 text-xs font-medium tracking-widest text-accent uppercase">{t('nav.faq')}</p>
      <h1 class="mt-3 font-display text-4xl leading-tight text-ink lg:text-5xl">{t('faq.hero.title')}</h1>
      <p class="mt-4 max-w-xl text-sm leading-6 text-ink-soft">
        {t('faq.hero.body')}
      </p>
    </div>
  </section>

  <section id="faq" class="relative z-2 border-t border-rule bg-paper px-4 pb-24 sm:px-8 lg:px-20 lg:pb-32">
    <div class="mx-auto mt-10 max-w-3xl">
      {
        categories.length > 0 && questions.length > 0 ? (
          <FaqAccordion client:load categories={categories} questions={questions} labels={labels} />
        ) : (
          <div class="rounded-lg border border-rule bg-paper-warm p-8">
            <h2 class="font-display text-2xl text-ink">{t('faq.empty.title')}</h2>
            <p class="mt-2 text-sm leading-6 text-ink-soft">{t('faq.empty.body')}</p>
          </div>
        )
      }
    </div>
  </section>
</Layout>
