---
import Layout from '@/app/layout.astro';
import { EventRegistration } from '@/features/events/event-registration';
import { getEventBySlug } from '@/features/events/events';
import { WIX_APPS } from '@wix/essentials';
import { SEO } from '@wix/seo/components';
import { loadSEOTagsServiceConfig } from '@wix/seo/services';
import { seoTags } from '@wix/seo';
import { currentLanguage, localize, useTranslation } from '@/shared/i18n';
import { renderRicos } from '@/shared/ricos';

export const wixMetadata = {
  appDefId: WIX_APPS.events.id,
  pageIdentifier: WIX_APPS.events.eventPageMetadata.pageIdentifier,
  identifiers: { slug: WIX_APPS.events.eventPageMetadata.identifiers.slug },
};

const { t } = useTranslation();
const { slug } = Astro.params;

const forwardedUrl = Astro.request.headers.get('x-wix-forwarded-url');
const pageUrl =
  forwardedUrl && URL.canParse(forwardedUrl) && /^https?:$/.test(new URL(forwardedUrl).protocol)
    ? forwardedUrl
    : Astro.url.href;

const [event, seoTagsServiceConfig] = await Promise.all([
  getEventBySlug(slug ?? ''),
  loadSEOTagsServiceConfig({
    pageUrl: slug ? pageUrl : '',
    itemType: seoTags.ItemType.EVENTS_PAGE,
    itemData: { slug: slug ?? '' },
  }).catch(() => null),
]);

const missing = !event;
if (missing) {
  Astro.response.status = 404;
}

const locale = currentLanguage();

const eventDate = event?.startUtc
  ? new Intl.DateTimeFormat(locale, {
      weekday: 'long',
      day: 'numeric',
      month: 'long',
      year: 'numeric',
      timeZone: event.timeZoneId || 'UTC',
    }).format(new Date(event.startUtc))
  : null;

function formatTimeRange(start: string | null, end: string | null, timeZoneId: string | null): string {
  if (!start) return '';
  try {
    const time = new Intl.DateTimeFormat(locale, {
      hour: '2-digit',
      minute: '2-digit',
      timeZone: timeZoneId || 'UTC',
    });
    const endDate = end ? ` – ${time.format(new Date(end))}` : '';
    return `${time.format(new Date(start))}${endDate}`;
  } catch {
    return '';
  }
}

const eventTime = event ? formatTimeRange(event.startUtc, event.endUtc, event.timeZoneId) : '';
const descriptionHtml = event ? renderRicos(event.description) : '';
---

<Layout>
  {missing && <Fragment slot="head"><meta name="robots" content="noindex" /></Fragment>}
  {event && seoTagsServiceConfig && <SEO.Tags seoTagsServiceConfig={seoTagsServiceConfig} slot="seo-tags" />}

  {missing && (
    <section class="relative z-2 bg-paper px-4 pt-24 pb-24 text-ink sm:px-8 lg:px-20 lg:pt-32">
      <div class="mx-auto max-w-6xl">
        <p class="text-xs font-medium tracking-widest text-accent uppercase">{t('events.not-found.eyebrow')}</p>
        <h1 class="mt-3 font-display text-3xl leading-tight text-ink lg:text-4xl">{t('events.not-found.title')}</h1>
        <p class="mt-3 max-w-xl text-sm leading-6 text-ink-soft">{t('events.not-found.body')}</p>
        <a href={localize('/events')} class="mt-4 inline-flex text-sm text-accent hover:underline">{t('events.not-found.link')}</a>
      </div>
    </section>
  )}

  {!missing && event && (
  <section class="relative z-2 bg-paper px-4 pt-16 pb-10 text-ink sm:px-8 lg:px-20 lg:pt-24 lg:pb-16">
    <div class="mx-auto max-w-6xl">
      <nav class="text-sm text-ink-soft" aria-label="Breadcrumb">
        <a href={localize('/')} class="transition-colors hover:text-accent">{t('nav.home')}</a>
        <span aria-hidden="true"> · </span>
        <a href={localize('/events')} class="transition-colors hover:text-accent">{t('nav.events')}</a>
        <span aria-hidden="true"> · </span>
        <span aria-current="page" class="text-ink">{event.title}</span>
      </nav>

      <div class="mt-8 grid grid-cols-1 gap-8 lg:grid-cols-2 lg:gap-12">
        <div class="relative flex aspect-4/5 items-center justify-center overflow-hidden rounded-lg bg-paper-warm px-6 ring-1 ring-rule lg:aspect-auto lg:min-h-120">
          {event.image ? (
            <img
              src={event.image.url}
              alt={event.image.altText}
              width={event.image.width}
              height={event.image.height}
              loading="lazy"
              class="absolute inset-0 size-full object-cover"
            />
          ) : (
            <div class="relative z-2 text-center">
              <p class="text-xs font-medium tracking-widest text-accent uppercase">{t('events.eyebrow')}</p>
              <p class="mt-3 font-display text-2xl leading-tight text-ink">{event.title}</p>
            </div>
          )}
        </div>

        <div class="flex flex-col gap-6">
          <div>
            <div class="flex flex-wrap items-center gap-2.5 text-xs font-medium tracking-widest text-mute uppercase">
              {eventDate && <p>{eventDate}</p>}
              {eventDate && event.initialType && <span aria-hidden="true" class="text-rule">·</span>}
              <p>{event.initialType === 'RSVP' ? t('events.badge-free') : t('events.badge-tickets')}</p>
            </div>
            <h1 class="mt-3 font-display text-3xl leading-tight text-ink lg:text-4xl">{event.title}</h1>
            {event.shortDescription && (
              <p class="mt-3 text-base leading-6 text-ink-soft">{event.shortDescription}</p>
            )}
          </div>

          {descriptionHtml && (
            <div class="journal-body border-t border-rule pt-5 max-w-prose text-sm text-ink-soft" set:html={descriptionHtml} />
          )}

          <div class="border-t border-rule pt-5">
            <p class="text-xs font-medium tracking-widest text-mute uppercase">{t('events.where-when')}</p>
            <div class="mt-2 flex flex-col gap-1 text-sm text-ink-soft">
              {eventDate && <p>{eventDate}</p>}
              {eventTime && <p>{eventTime}</p>}
              {event.venue && <p>{event.venue}</p>}
            </div>
          </div>

          <div class="border-t border-rule pt-5">
            <EventRegistration
              client:load
              mode={event.initialType === 'RSVP' ? 'rsvp' : 'tickets'}
              eventId={event.id}
              slug={event.slug}
              locale={locale}
              labels={{
                detailsTitle: t('events.details-title'),
                firstName: t('events.field.first-name'),
                lastName: t('events.field.last-name'),
                email: t('events.field.email'),
                invalid: t('events.field.invalid'),
                submit: t('events.rsvp.submit'),
                submitTickets: t('events.tickets.submit'),
                submitting: t('events.rsvp.submitting'),
                successTitle: t('events.rsvp.success-title'),
                successBody: t('events.rsvp.success-body'),
                error: t('events.rsvp.error'),
                postFlowError: t('events.tickets.post-flow-error'),
                paymentGate: t('events.tickets.payment-gate'),
                retry: t('events.retry'),
                pickTier: t('events.tickets.pick-tier'),
                quantity: t('events.tickets.quantity'),
                decreaseQuantity: t('events.tickets.decrease'),
                increaseQuantity: t('events.tickets.increase'),
                freeBadge: t('events.badge-free'),
                soldOut: t('events.tickets.sold-out'),
                saleEnded: t('events.tickets.sale-ended'),
                saleScheduled: t('events.tickets.sale-scheduled'),
                ticketsError: t('events.tickets.error'),
                loadingTiers: t('events.tickets.loading'),
              }}
            />
          </div>
        </div>
      </div>
    </div>
  </section>
  )}
</Layout>

<style is:global>
  .journal-body h1,
  .journal-body h2,
  .journal-body h3 {
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
    font-family: var(--font-display);
    font-size: 1.375rem;
    line-height: 1.3;
    color: var(--color-ink);
  }
  .journal-body p + p {
    margin-top: 0.75rem;
  }
  .journal-body ul {
    margin-top: 0.75rem;
    padding-left: 1.25rem;
    list-style: disc;
  }
  .journal-body ol {
    margin-top: 0.75rem;
    padding-left: 1.25rem;
    list-style: decimal;
  }
  .journal-body li {
    margin-top: 0.35rem;
  }
  .journal-body blockquote {
    margin-top: 1rem;
    padding-left: 1rem;
    border-left: 2px solid var(--color-accent);
    font-style: italic;
    color: var(--color-ink-soft);
  }
  .journal-body a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
