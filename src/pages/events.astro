---
import Layout from '@/app/layout.astro';
import { listEvents, type EventInfo } from '@/features/events/events';
import { currentLanguage, localize, useTranslation } from '@/shared/i18n';

const { t } = useTranslation();

const events = await listEvents();

const locale = currentLanguage();

function formatEventDate(event: EventInfo): string {
  if (!event.startUtc) return '';
  try {
    return new Intl.DateTimeFormat(locale, {
      weekday: 'long',
      day: 'numeric',
      month: 'long',
      timeZone: event.timeZoneId || 'UTC',
    }).format(new Date(event.startUtc));
  } catch {
    return event.formattedDate ?? '';
  }
}

function formatEventTime(event: EventInfo): string {
  if (!event.startUtc) return '';
  try {
    const time = new Intl.DateTimeFormat(locale, {
      hour: '2-digit',
      minute: '2-digit',
      timeZone: event.timeZoneId || 'UTC',
    });
    const start = time.format(new Date(event.startUtc));
    const end = event.endUtc ? ` – ${time.format(new Date(event.endUtc))}` : '';
    return `${start}${end}`;
  } catch {
    return '';
  }
}

function formatEventPrice(event: EventInfo): string | null {
  if (event.initialType === 'RSVP' || !event.lowestPrice?.value) return null;
  const amount = Number(event.lowestPrice.value);
  if (!Number.isFinite(amount)) return null;
  const currency = event.lowestPrice.currency || 'EUR';
  const formatted = new Intl.NumberFormat(locale, { style: 'currency', currency }).format(amount);
  return t('events.card.from', { price: formatted });
}
---

<Layout>
  <Fragment slot="head">
    <meta name="description" content={t('events.meta-description')} />
  </Fragment>

  <section class="relative z-2 bg-paper px-4 pt-24 pb-10 text-ink sm:px-8 lg:px-20 lg:pt-32">
    <div class="mx-auto max-w-6xl">
      <nav class="text-sm text-ink-soft" aria-label="Breadcrumb">
        <a href={localize('/')} class="transition-colors hover:text-accent">{t('nav.home')}</a>
        <span aria-hidden="true"> · </span>
        <span aria-current="page" class="text-ink">{t('nav.events')}</span>
      </nav>
      <p class="mt-6 text-xs font-medium tracking-widest text-accent uppercase">{t('events.eyebrow')}</p>
      <h1 class="mt-3 font-display text-4xl leading-tight text-ink lg:text-5xl">{t('events.title')}</h1>
      <p class="mt-4 max-w-xl text-sm leading-6 text-ink-soft">{t('events.intro')}</p>
    </div>
  </section>

  <section class="relative z-2 bg-paper px-4 pb-24 sm:px-8 lg:px-20 lg:pb-32">
    <div class="mx-auto max-w-6xl">
      {
        events.length > 0 ? (
          <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-6">
            {events.map((event) => (
              <li>
                <a
                  href={localize(`/events/${event.slug}`)}
                  data-event-slug={event.slug}
                  class="group block h-full"
                >
                  <div
                    class="relative flex aspect-4/5 items-center justify-center overflow-hidden rounded-lg bg-paper-warm px-6 ring-1 ring-rule"
                    transition:name={event.slug ? `event-${event.slug}` : undefined}
                  >
                    {event.image ? (
                      <img
                        src={event.image.url}
                        alt={event.image.altText}
                        width={event.image.width}
                        height={event.image.height}
                        loading="lazy"
                        class="absolute inset-0 size-full object-cover"
                      />
                    ) : (
                      <div class="text-center">
                        <p class="text-xs font-medium tracking-widest text-accent uppercase">{t('events.eyebrow')}</p>
                        <p class="mt-3 font-display text-2xl leading-tight text-ink">{event.title}</p>
                      </div>
                    )}
                    <span class="absolute top-3 right-3 rounded-full bg-paper px-3 py-1 text-xs font-medium text-ink ring-1 ring-rule">
                      {event.initialType === 'RSVP' ? t('events.badge-free') : t('events.badge-tickets')}
                    </span>
                  </div>
                  <p class="mt-4 text-xs font-medium tracking-widest text-accent uppercase">{formatEventDate(event)}</p>
                  <p class="mt-1 text-xs font-medium tracking-widest text-mute uppercase">{formatEventTime(event)}</p>
                  <h3 class="mt-2 font-display text-base leading-tight text-ink lg:text-lg">{event.title}</h3>
                  {event.shortDescription && (
                    <p class="mt-1 text-sm leading-6 text-ink-soft">{event.shortDescription}</p>
                  )}
                  {event.venue && <p class="mt-1 text-sm text-ink-soft">{event.venue}</p>}
                  {formatEventPrice(event) && (
                    <p class="mt-2 text-sm font-medium text-ink">{formatEventPrice(event)}</p>
                  )}
                  <p class="mt-2 text-sm font-medium text-accent transition-colors duration-700 ease-fluid group-hover:underline">
                    {event.initialType === 'RSVP' ? t('events.cta-rsvp') : t('events.cta-tickets')}
                  </p>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="max-w-xl text-sm leading-6 text-ink-soft">{t('events.empty')}</p>
        )
      }
    </div>
  </section>
</Layout>
